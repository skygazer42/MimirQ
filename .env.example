# ============================================================
# MimirQ 完整环境
# ============================================================
# 用法：
# - 本地后端开发：cp .env.example .env
# - 前端开发：必要的 NEXT_PUBLIC_* 会在 Next.js 构建或运行时读取。
# - Docker 依赖服务：cd docker && cp .env.example .env
# - 每个 KEY=value 上方都有用途说明；未用到的高级能力保持默认即可。

# ----------------------------------------------------------------------------
# 01｜数据库、Docker 与 Redis
# ----------------------------------------------------------------------------
# 数据库、Docker Compose 与 Redis 相关。
# ----------------------------------------------------------------------------

# 数据库配置；PostgreSQL 数据库连接串。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimirq

# 数据库 Schema 管理（企业部署建议）；本地/开发：保持默认即可（启动时自动 create_all + best-effort runtime migrations）；生产/多副本：建议关闭自动建表与 runtime migrations，并通过 Alembic 在部署流程里执行迁移。
MIMIRQ_DB_CREATE_ALL_ON_STARTUP=true

# 是否在启动时执行 MimirQ 数据库运行时迁移。
MIMIRQ_DB_RUNTIME_MIGRATIONS_ENABLED=true

# Docker 部署（docker-compose.yml）；Docker Compose 会使用以下 POSTGRES_* 创建 Postgres 容器（未设置时使用默认值）。
POSTGRES_DB=mimirq

# PostgreSQL 用户名。
POSTGRES_USER=postgres

# PostgreSQL 密码。
POSTGRES_PASSWORD=

# Docker 构建阶段使用的网络；普通环境保持 default，Linux 回环代理场景可临时设为 host。
DOCKER_BUILD_NETWORK=default

# Docker Compose 内部访问 Milvus 的主机名。
MILVUS_HOST_DOCKER=mimirq-milvus

# Milvus 向量库端口（Docker Compose 容器内使用）。
MILVUS_PORT_DOCKER=19530

# 是否在 Docker Compose 中启用 MinIO 对象存储。
MINIO_ENABLED_DOCKER=true

# MinIO 对象存储地址（Docker Compose 容器内使用）。
MINIO_ENDPOINT_DOCKER=mimirq-minio:9000

# Docker Compose 中 MinIO 的访问密钥。
MINIO_ACCESS_KEY_DOCKER=minioadmin

# Docker Compose 中 MinIO 的私密密钥。
MINIO_SECRET_KEY_DOCKER=minioadmin

# MinIO 对象存储桶名称（Docker Compose 容器内使用）。
MINIO_BUCKET_NAME_DOCKER=mimirq

# Docker Compose 中连接 MinIO 时是否使用 SSL。
MINIO_USE_SSL_DOCKER=false

# Docker Compose 中是否把源文档保存到 MinIO。
MINIO_DOCUMENTS_ENABLED_DOCKER=true

# Redis 地址（Docker Compose 容器内使用）。
REDIS_URL_DOCKER=redis://mimirq-redis:6379/0

# 是否启用任务队列（Docker Compose 容器内使用）。
TASK_QUEUE_ENABLED_DOCKER=true

# 任务队列关闭时，API 进程内后台文档处理的最大并发数，避免解析和 KG 抽取耗尽数据库连接。
API_DOCUMENT_BACKGROUND_MAX_CONCURRENCY=2

# KG 任务在并发令牌被占用时的重试退避秒数。
# 若该值过小，而单次 KG 抽取本身耗时较长，后续文档可能会在锁释放前耗尽默认重试次数。
TASK_KG_RETRY_DEFER_SEC=30

# 上传路径（Docker Compose 容器内使用）。
UPLOAD_DIR_DOCKER=/data/uploads

# 可选：构建元数据（会在 /api/v1/meta 暴露）。
MIMIRQ_BUILD_SHA=

# MimirQ 构建时间，可选。
MIMIRQ_BUILD_TIME=

# 可选：后端 worker 数（docker-compose.yml 使用；默认 1）。
BACKEND_WORKERS=1

# Redis 配置（可选）；Redis 连接串（用于任务队列/Embedding 缓存/分布式限流等）。
REDIS_URL=redis://localhost:6379/0

# API 请求限流配置；是否启用请求限流。
RATE_LIMIT_ENABLED=true

# 全局限流：每秒请求数（RPS）。
RATE_LIMIT_REQUESTS_PER_SECOND=10.0

# 全局限流：突发容量（默认约等于 RPS*2）。
RATE_LIMIT_BURST_SIZE=20

# Chat 接口：更严格的限流（RPS）。
RATE_LIMIT_CHAT_RPS=2.0

# Chat 接口：突发容量。
RATE_LIMIT_CHAT_BURST=5

# 可选：Redis 分布式限流（多进程/多实例推荐；Redis 不可用时 fail-open）。
RATE_LIMIT_REDIS_ENABLED=false

# Redis key 前缀。
RATE_LIMIT_REDIS_PREFIX=rl

# Redis key TTL（秒）。
RATE_LIMIT_REDIS_KEY_TTL_SEC=600

# ----------------------------------------------------------------------------
# 02｜前端、OIDC 与 SSR
# ----------------------------------------------------------------------------
# 前端构建、浏览器公开变量、OIDC 登录与 SSR 调用后端相关。
# ----------------------------------------------------------------------------

# 可选：前端构建参数（NEXT_PUBLIC_* 会在 Next.js build 时固化）。
NEXT_PUBLIC_API_URL=http://localhost:8000

# 前端请求 API 的超时时间（毫秒）。
NEXT_PUBLIC_API_TIMEOUT_MS=60000

# 前端长任务 API 的超时时间（毫秒）。
NEXT_PUBLIC_API_LONG_TIMEOUT_MS=600000

# 前端开发环境默认用户 ID。
NEXT_PUBLIC_USER_ID=demo

# 前端开发环境默认租户 ID。
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# 前端是否启用 OIDC 登录。
NEXT_PUBLIC_OIDC_ENABLED=false

# 前端使用的 OIDC 签发方地址。
NEXT_PUBLIC_OIDC_ISSUER=

# 前端使用的 OIDC 客户端 ID。
NEXT_PUBLIC_OIDC_CLIENT_ID=

# 前端 OIDC 授权范围。
NEXT_PUBLIC_OIDC_SCOPES="openid profile email"

# 前端 OIDC 登录回调地址。
NEXT_PUBLIC_OIDC_REDIRECT_URI=

# 前端 OIDC 额外认证参数。
NEXT_PUBLIC_OIDC_AUTH_PARAMS=

# 后端是否启用 OIDC 授权码交换。
OIDC_SERVER_EXCHANGE_ENABLED=

# 后端校验 OIDC Token 时使用的签发方地址。
OIDC_ISSUER=

# 后端 OIDC 客户端 ID。
OIDC_CLIENT_ID=

# 后端 OIDC 客户端密钥。
OIDC_CLIENT_SECRET=

# 后端 OIDC 客户端认证方式。
OIDC_CLIENT_AUTH_METHOD=basic

# 可选：前端容器端口（docker/docker-compose.web.yml 使用；默认 3000）。
WEB_PORT=3000

# Docker 前端给浏览器使用的 API 地址；默认同源代理，避免把容器内主机名暴露给浏览器。
NEXT_PUBLIC_API_URL_DOCKER=/

# 可选：前端容器内部调用后端的地址（docker/docker-compose.web.yml 使用；SSR 场景需要）。
API_INTERNAL_URL_DOCKER=http://mimirq-api:8000

# 后端只信任这些代理提供的 X-Forwarded-*；默认值对应 docker-compose.web.yml 的固定地址。
FORWARDED_ALLOW_IPS_DOCKER=127.0.0.1,172.30.0.10
MIMIRQ_PROXY_SUBNET=172.30.0.0/24
WEB_PROXY_IP_DOCKER=172.30.0.10

# ----------------------------------------------------------------------------
# 03｜认证、跨域、限流与配额
# ----------------------------------------------------------------------------
# 认证方式、JWT/OIDC 校验、CORS、请求限流和租户配额相关。
# ----------------------------------------------------------------------------

# 安全与认证配置；默认 jwt。仅本机联调时可显式改为 header（使用 X-User-ID）。
AUTH_MODE=jwt

# JWT 密钥（AUTH_MODE=jwt 时必填，生产环境务必更换为随机字符串，长度>=32）。
SECRET_KEY=

# JWT 算法。
ALGORITHM=HS256

# JWT JWKS 地址列表，多个地址用逗号分隔。
JWT_JWKS_URLS=

# 是否启用 JWT JWKS 自动发现。
JWT_JWKS_DISCOVERY_ENABLED=false

# OIDC 发现配置缓存时间（秒）。
JWT_OIDC_DISCOVERY_CACHE_TTL_SEC=3600

# OIDC 发现配置允许过期复用的最长时间（秒）。
JWT_OIDC_DISCOVERY_MAX_STALE_SEC=86400

# OIDC 发现请求超时时间（秒）。
JWT_OIDC_DISCOVERY_HTTP_TIMEOUT_SEC=5.0

# JWT JWKS 缓存时间（秒）。
JWT_JWKS_CACHE_TTL_SEC=300

# JWT JWKS 允许过期复用的最长时间（秒）。
JWT_JWKS_MAX_STALE_SEC=3600

# JWT JWKS 请求超时时间（秒）。
JWT_JWKS_HTTP_TIMEOUT_SEC=5.0

# JWT 签发方，留空则不校验。
JWT_ISSUER=

# JWT 受众，留空则不校验。
JWT_AUDIENCE=

# JWT 中表示租户 ID 的声明字段。生产环境 jwt 模式必须配置本项，或显式设 TENANT_HEADER_TRUSTED=true，否则拒绝启动。
JWT_TENANT_CLAIM=

# 是否要求 JWT 租户声明与请求头租户 ID 一致。
JWT_ENFORCE_TENANT_HEADER_MATCH=false

# 生产环境显式信任客户端/网关提供的租户请求头作为租户来源。
# 仅当可信网关会剥离并重新注入该头、或部署实际为单租户时才安全；否则请改配 JWT_TENANT_CLAIM。
TENANT_HEADER_TRUSTED=false

# 访问令牌过期时间（分钟）。
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 跨域配置 (CORS)；允许的跨域来源（逗号分隔）。
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 允许浏览器在跨域响应中读取的 Header（用于前端拿到 request_id / 重试信息等）。
CORS_EXPOSE_HEADERS=X-Request-ID,X-Process-Time-Ms,Server-Timing,Retry-After

# 是否返回 Server-Timing Header（用于简单性能分析）。
SERVER_TIMING_ENABLED=true

# 服务器配置；监听地址。
# 默认 127.0.0.1 仅本机可访问。生产/容器部署需显式改为 0.0.0.0，
# 且务必先设置 ENV=production 与 AUTH_MODE=jwt（否则 header 认证模式下任意人可冒充任意用户）。
HOST=127.0.0.1

# 监听端口。
PORT=8000

# 文档数量配额（按 tenant，禁用文档不计入）。
TENANT_DOC_QUOTA_ENABLED=false

# 租户文档数量配额上限。
TENANT_DOC_QUOTA_LIMIT=0

# 存储字节配额（按 tenant，按 documents.file_size 求和）。
TENANT_STORAGE_QUOTA_ENABLED=false

# 租户存储配额上限（字节）。
TENANT_STORAGE_QUOTA_LIMIT_BYTES=0

# Embedding 工作量配额（按 tenant，近似为字符数；rolling window）。
TENANT_EMBED_CHAR_QUOTA_ENABLED=false

# 租户 Embedding 字符配额上限。
TENANT_EMBED_CHAR_QUOTA_LIMIT=0

# 租户 Embedding 字符配额统计窗口（小时）。
TENANT_EMBED_CHAR_QUOTA_WINDOW_HOURS=24

# block: 超额直接阻断；observe: 仅记录元数据/指标（不阻断）。
TENANT_EMBED_CHAR_QUOTA_MODE=block

# Tenant 级 QPS 配额（用于防止单租户打爆 chat 接口）。
TENANT_QPS_QUOTA_ENABLED=false

# 租户 QPS 配额的每秒请求数。
TENANT_QPS_QUOTA_REQUESTS_PER_SECOND=0.0

# 租户QPS配额突发容量大小。
TENANT_QPS_QUOTA_BURST_SIZE=0

# 租户 QPS 配额模式。
TENANT_QPS_QUOTA_MODE=block

# Redis key 前缀与 TTL（秒）。
TENANT_QPS_QUOTA_REDIS_PREFIX=tq

# 租户 QPS 配额 Redis key 过期时间（秒）。
TENANT_QPS_QUOTA_REDIS_KEY_TTL_SEC=600

# ----------------------------------------------------------------------------
# 04｜向量库、对象存储与上传
# ----------------------------------------------------------------------------
# Milvus、MinIO、上传目录、ZIP 解压和静态资源缓存相关。
# ----------------------------------------------------------------------------

# Milvus 向量数据库配置；Milvus 服务器地址。
MILVUS_HOST=localhost

# Milvus 服务器端口。
MILVUS_PORT=19530

# Milvus 用户名（如无认证可留空）。
MILVUS_USER=

# Milvus 密码（如无认证可留空）。
MILVUS_PASSWORD=

# Milvus 集合名称。
MILVUS_COLLECTION_NAME=documents

# MinIO 对象存储配置（S3 兼容，用于图片存储）；是否启用 MinIO。
MINIO_ENABLED=false

# MinIO 服务端点。
MINIO_ENDPOINT=localhost:9000

# MinIO 访问密钥。
MINIO_ACCESS_KEY=minioadmin

# MinIO 私密密钥。
MINIO_SECRET_KEY=minioadmin

# MinIO 存储桶名称。
MINIO_BUCKET_NAME=mimirq

# 是否使用 SSL 连接。
MINIO_USE_SSL=false

# 是否将文档源文件存储到 MinIO（推荐企业级/多实例部署）。
MINIO_DOCUMENTS_ENABLED=false

# 文件上传配置；上传文件存储目录。
UPLOAD_DIR=./uploads

# 单文件最大大小（字节，默认 50MB）。
MAX_FILE_SIZE=50000000

# multipart 上传接口中 pipeline JSON 字段最大长度（字符数）。
PIPELINE_FORM_JSON_MAX_CHARS=200000

# ZIP 解压安全限制（用于 Markdown + images 压缩包）。
ZIP_MAX_FILES=2000

# ZIP最大总量解压后字节数。
ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=500000000

# ZIP最大单文件解压后字节数。
ZIP_MAX_SINGLE_UNCOMPRESSED_BYTES=100000000

# ZIP上限。
ZIP_MAX_IMAGES=300

# 内联图片上传限制（Markdown/HTML data URI / 本地图片 -> MinIO）。
MAX_INLINE_IMAGE_BYTES=10000000

# 内联图片最大数量。
MAX_INLINE_IMAGES=200

# 静态资源缓存（/api/v1/documents/image/{id}），0 表示禁用缓存（会返回 no-cache）。
ASSET_CACHE_MAX_AGE_SEC=3600

# 允许的文件扩展名（逗号分隔）。
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.rst,.adoc,.asciidoc,.tex,.yaml,.yml,.toml,.sql,.log,.conf,.ini,.cfg,.env,.properties,.patch,.diff,.srt,.vtt,.mk,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.csv,.html,.htm,.json,.jsonl,.ndjson,.xml,.rss,.atom,.graphql,.gql,.proto,.tf,.hcl,.js,.jsx,.mjs,.cjs,.ts,.tsx,.mts,.cts,.py,.pyi,.rs,.go,.java,.kt,.kts,.c,.h,.cc,.cpp,.cxx,.hpp,.cs,.php,.rb,.swift,.scala,.sh,.bash,.zsh,.ps1,.lua,.r,.vue,.svelte,.astro,.css,.scss,.sass,.less

# ----------------------------------------------------------------------------
# 05｜大模型、HTTP 客户端与 Embedding
# ----------------------------------------------------------------------------
# LLM、Embedding、HTTP 客户端连接池和重试策略相关。
# ----------------------------------------------------------------------------

# 【必填】默认硅基流动配置唯一需要填写的值；不要提交真实密钥。
LLM_API_KEY=

# LLM API 基础地址；默认使用硅基流动 OpenAI 兼容接口。
LLM_API_BASE=https://api.siliconflow.cn/v1

# 默认主模型名称。
LLM_MODEL=Qwen/Qwen3-32B

# 快速模型（可选，用于低成本/低延迟场景）。
LLM_MODEL_FAST=

# 重型模型（可选，用于复杂问题需要高质量回答）。
LLM_MODEL_HEAVY=

# 是否启用动态模型路由（根据问题复杂度自动选择模型）。
ENABLE_DYNAMIC_MODEL_ROUTING=false

# 动态路由复杂度阈值（问题字符数超过此值使用 heavy 模型）。
MODEL_COMPLEXITY_THRESHOLD=160

# 动态路由历史权重（历史消息对复杂度评分的权重）。
MODEL_COMPLEXITY_HISTORY_WEIGHT=0.35

# 模型温度参数（0-1，越高越随机）。
LLM_TEMPERATURE=0.7

# API 请求超时时间（秒）。
LLM_TIMEOUT=60

# API 请求最大重试次数。
LLM_MAX_RETRIES=3

# 是否复用池化异步 HTTP 客户端，适合高并发 LLM 调用。
LLM_USE_POOLED_ASYNC_HTTP_CLIENT=false

# HTTP Client (httpx) 配置；是否启用 HTTP/2（需要安装 httpx[http2] / h2）。
HTTP_CLIENT_HTTP2_ENABLED=true

# 连接池最大连接数。
HTTP_CLIENT_MAX_CONNECTIONS=100

# keep-alive 连接数。
HTTP_CLIENT_MAX_KEEPALIVE_CONNECTIONS=20

# keep-alive 过期时间（秒）。
HTTP_CLIENT_KEEPALIVE_EXPIRY_SEC=30.0

# 连接/读取/写入/连接池获取超时（秒）。
HTTP_CLIENT_TIMEOUT_CONNECT_SEC=10.0

# HTTP 客户端超时读取时间（秒）。
HTTP_CLIENT_TIMEOUT_READ_SEC=60.0

# HTTP 客户端超时写入时间（秒）。
HTTP_CLIENT_TIMEOUT_WRITE_SEC=30.0

# HTTP 客户端超时连接池时间（秒）。
HTTP_CLIENT_TIMEOUT_POOL_SEC=5.0

# 自动重试参数（网络错误 / 5xx / 429）。
HTTP_CLIENT_RETRY_MAX_RETRIES=3

# HTTP 客户端重试初始延迟时间（秒）。
HTTP_CLIENT_RETRY_INITIAL_DELAY_SEC=1.0

# HTTP 客户端重试退避系数。
HTTP_CLIENT_RETRY_BACKOFF_FACTOR=2.0

# HTTP 客户端重试抖动时间（秒）。
HTTP_CLIENT_RETRY_JITTER_SEC=0.2

# 向量模型 (Embedding) 配置；Embedding 提供商（openai_compatible / local / dashscope / ollama）。
EMBEDDING_PROVIDER=openai_compatible

# Embedding 模型名称。
EMBEDDING_MODEL=BAAI/bge-m3

# Embedding API 密钥（如与 LLM 相同可留空）。
EMBEDDING_API_KEY=

# Embedding API 基础地址；留空时复用 LLM_API_BASE。DashScope 兼容接口示例：https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_BASE=

# ----------------------------------------------------------------------------
# 05.1｜RAGAS / 评测运行时
# ----------------------------------------------------------------------------
# RAGAS response relevancy 生成候选数；0 表示自动。DeepSeek 等不支持 n>1 的兼容接口会自动降到 1。
RAGAS_RESPONSE_RELEVANCY_STRICTNESS=0

# RAGAS 单操作超时与重试；避免评测供应商异常时把后台任务长时间拖成 running。
RAGAS_RUN_TIMEOUT_SEC=60
RAGAS_RUN_MAX_RETRIES=1
RAGAS_RUN_MAX_WAIT_SEC=2
RAGAS_RUN_MAX_WORKERS=4

# 会话评测整轮墙钟上限；超时后自动降级为确定性忠实度/相关性评测，避免 run 永久停在 running。
RAGAS_CONVERSATION_WALL_TIMEOUT_SEC=90

# 会话评测是否强制使用无 LLM 的确定性分数。默认 false；DeepSeek 评测后端会自动启用兼容路径。
RAGAS_CONVERSATION_DETERMINISTIC_MODE_ENABLED=false

# ----------------------------------------------------------------------------
# 06｜RAG、检索、切块与表格 TAG
# ----------------------------------------------------------------------------
# RAG 检索、上下文预算、BM25、表格 TAG、查询重写和忠实度评分相关。
# ----------------------------------------------------------------------------

# RAG 检索配置；文本切块大小（字符数）。
CHUNK_SIZE=1000

# 切块重叠大小（字符数）。
CHUNK_OVERLAP=200

# 过滤过短切片（字符数，0 表示关闭）。
CHUNK_MIN_CHARS=30

# 检索返回的 Top-K 数量。
RETRIEVAL_TOP_K=5

# 相似度阈值（0-1，低于此值的结果会被过滤）。
SIMILARITY_THRESHOLD=0.7

# 多查询变体并发度；生产可按 CPU/DB/向量库容量调高，避免多路召回线性变慢。
RETRIEVAL_QUERY_PARALLELISM=1

# 轻量多意图拆分：不调用 LLM，只按明显标点/并列结构拆成少量子查询后走同一套融合/重排。
RETRIEVAL_LIGHTWEIGHT_SUBQUERY_ENABLED=false
RETRIEVAL_LIGHTWEIGHT_SUBQUERY_MAX_QUERIES=3
RETRIEVAL_LIGHTWEIGHT_SUBQUERY_MIN_QUERY_CHARS=28

# 可选：查询意图路由（faq/howto/api/log） -> 检索 preset/profile（确定性、PII-safe；默认关闭以避免行为变化）。
RAG_INTENT_ROUTER_ENABLED=false

# MMR 多样性参数（0-1，越高结果越多样）。
RETRIEVAL_MMR_LAMBDA=0.7

# 检索融合策略（linear / rrf）。
RETRIEVAL_FUSION_STRATEGY=linear

# RRF 融合常数 k（越大越“平滑”）。
RETRIEVAL_RRF_K=60

# 检索结果后处理（去重/多样性）。
RETRIEVAL_DEDUP_ENABLED=true

# 检索去重Jaccard阈值。
RETRIEVAL_DEDUP_JACCARD_THRESHOLD=0.92

# 检索去重上限。
RETRIEVAL_DEDUP_MAX_COMPARE=50

# 每个文档最多返回的切片数（0 关闭）。
RETRIEVAL_MAX_CHUNKS_PER_DOC=3

# 高置信断崖式得分时压缩最终上下文（默认关闭；可由插件策略打开）。
RETRIEVAL_COMPACT_HIGH_CONFIDENCE_ENABLED=false
RETRIEVAL_COMPACT_MIN_TOP_SCORE=0.8
RETRIEVAL_COMPACT_RELATIVE_SCORE_FLOOR=0.65
RETRIEVAL_COMPACT_MIN_RECORDS=1

# 最少覆盖的不同文档数（0 关闭）。
RETRIEVAL_MIN_DISTINCT_DOCS=0

# Prompt 上下文长度保护（0 关闭）。
RAG_CONTEXT_MAX_CHARS_PER_CHUNK=1500

# RAG 上下文总字符数上限。
RAG_CONTEXT_MAX_TOTAL_CHARS=12000

# RAG 上下文中知识图谱字符数上限。
RAG_CONTEXT_MAX_KG_CHARS=3000

# 可选：按 token 限制（0 关闭；开启后优先于 chars 限制）。
RAG_CONTEXT_MAX_TOKENS_PER_CHUNK=0

# RAG 上下文总 token 数上限。
RAG_CONTEXT_MAX_TOTAL_TOKENS=0

# RAG 上下文中知识图谱 token 数上限。
RAG_CONTEXT_MAX_KG_TOKENS=0

# Cost attribution（Wave22-T095）：LLM prompt token 估算时附加的固定开销（用于覆盖模板/系统指令等）；仅影响“成本归因/仪表盘”，不影响真实调用。
COST_PROMPT_OVERHEAD_TOKENS=50

# 上下文邻近切片扩展：每个命中切片额外补齐前后 N 个切片（0 关闭）。
RAG_CONTEXT_NEIGHBOR_WINDOW=0

# 最多额外补充的邻近切片数量（0 不限制）。
RAG_CONTEXT_NEIGHBOR_MAX_ADDED=20

# 是否启用“证据句抽取/上下文压缩”（按 query 从每个 chunk 选相关句子）。
RAG_CONTEXT_EVIDENCE_ENABLED=false

# 每个 chunk 最多保留的句子数。
RAG_CONTEXT_EVIDENCE_MAX_SENTENCES_PER_CHUNK=6

# 句子最小长度（字符），过短会跳过。
RAG_CONTEXT_EVIDENCE_MIN_SENTENCE_CHARS=10

# 是否启用“无召回/低证据”拒答保护（避免幻觉回答）。
RAG_ABSTAIN_ENABLED=false

# 最少引用数量（小于该值则直接拒答）。
RAG_ABSTAIN_MIN_CITATIONS=1

# Top 引用最小相关性分数（0 关闭；小于该值则拒答）。
RAG_ABSTAIN_MIN_TOP_RELEVANCE_SCORE=0

# 是否在 Evidence API 首轮无证据时启用一次迭代召回兜底。
EVIDENCE_ITERATIVE_RETRIEVE_ENABLED=false

# 证据迭代检索上限。
EVIDENCE_ITERATIVE_RETRIEVE_MAX_PASSES=2

# 证据迭代召回使用的兜底配置档。
EVIDENCE_ITERATIVE_RETRIEVE_FALLBACK_PROFILE=coverage80

# 证据迭代召回使用的兜底检索模式。
EVIDENCE_ITERATIVE_RETRIEVE_FALLBACK_MODE=keyword

# 向量存储后端配置；向量存储后端（milvus / faiss / chroma / memory）。
VECTOR_BACKEND=milvus

# FAISS 本地存储路径。
FAISS_STORE_PATH=./vector_faiss

# Chroma 持久化路径。
CHROMA_PERSIST_PATH=./vector_chroma

# 索引开关配置；是否启用文本块向量索引。
CHUNK_VECTOR_ENABLED=true

# 是否启用进程内 BM25 关键词索引。
# 多实例可设为 false，直接使用共享 Postgres 词法召回，避免每个副本重复预热；上线前请用本业务题集验证召回。
BM25_INDEX_ENABLED=true

# Hybrid/MMR 检索默认把 Postgres 词法召回作为兜底，候选不足时才触发；keyword 模式仍优先使用词法召回。
LEXICAL_DB_HYBRID_FALLBACK_ONLY=true

# BM25 懒加载（解决多进程/重启后 BM25 未初始化导致的关键词召回缺失）。
BM25_LAZY_BUILD_ENABLED=true

# 若未指定 document_ids，是否为整个 tenant 构建 BM25（可能较慢）。
BM25_LAZY_BUILD_FULL_TENANT=false

# 懒加载最大 chunk 数（0 不限制）。
BM25_LAZY_BUILD_MAX_CHUNKS=8000

# 是否启用 BM25 ASCII 分词扩展。
BM25_TOKENIZE_ASCII_EXPAND_ENABLED=true

# 是否启用 BM25 数字归一化。
BM25_TOKENIZE_NUMERIC_NORMALIZATION_ENABLED=true

# 是否启用 BM25 中文 OOV bigram 分词。
BM25_TOKENIZE_CJK_OOV_BIGRAM_ENABLED=true

# BM25 中文 OOV 词项最大字符数。
BM25_TOKENIZE_CJK_OOV_MAX_TERM_CHARS=8

# BM25 中文 OOV 额外 token 数上限。
BM25_TOKENIZE_CJK_OOV_MAX_EXTRA_TOKENS=128

# 是否启用事件向量索引（KG）。
EVENT_VECTOR_ENABLED=true

# 是否启用实体向量索引（KG）。
ENTITY_VECTOR_ENABLED=true

# 是否启用表格存储。
TABLE_STORE_ENABLED=false

# 表格存储目录。
TABLE_STORE_DIR=./uploads/table_store

# 导入上限（0 关闭上限）。
TABLE_STORE_MAX_ROWS=200000

# 表格存储列数上限。
TABLE_STORE_MAX_COLS=500

# 最多导入的 Sheet 数（0 不限制；建议保守设置，避免极端 Excel 占用资源）。
TABLE_STORE_MAX_SHEETS=50

# 采样行数（写入 doc_metadata，用于预览；0 表示不持久化 sample_rows）。
TABLE_STORE_SAMPLE_ROWS=20

# 表格自动分流（可选）：当 table_store_enabled=true 时，按表格规模决定走 TAG 还是走 RAG；small tables -> 继续走解析/切块/索引（RAG）；large/complex tables -> 导入 SQLite（TAG / Text-to-SQL）。
TABLE_STORE_AUTO_ROUTE=false

# 表格自动分流的行数阈值。
TABLE_STORE_AUTO_ROW_THRESHOLD=5000

# 表格自动分流的列数阈值。
TABLE_STORE_AUTO_COL_THRESHOLD=80

# 表格自动分流的 Sheet 数阈值。
TABLE_STORE_AUTO_SHEET_THRESHOLD=5

# 表格自动分流的文件大小阈值（字节）。
TABLE_STORE_AUTO_FILE_BYTES_THRESHOLD=5000000

# 查询返回限制（API 安全边界）。
TABLE_QUERY_MAX_ROWS=200

# 表格查询返回列数上限。
TABLE_QUERY_MAX_COLS=200

# 表格查询返回字节数上限。
TABLE_QUERY_MAX_BYTES=1000000

# SQL 执行保护（DoS 防护）。
TABLE_QUERY_MAX_SQL_CHARS=20000

# 表格查询超时时间（秒）。
TABLE_QUERY_TIMEOUT_SEC=5.0

# 表格查询进度回调的操作数间隔。
TABLE_QUERY_PROGRESS_OPS=10000

# NL -> SQL（TAG）：自然语言生成 SELECT（会再次经过 SQL 执行器的只读校验）。
TABLE_NL2SQL_ENABLED=false

# 数据外发控制：是否允许把表格查询结果/行数据发送给 LLM（默认关闭）。
TABLE_LLM_ALLOW_RESULT_EGRESS=false

# 是否允许把表格行数据发送给 LLM。
TABLE_LLM_ALLOW_ROW_EGRESS=false

# LOTUS-like 语义算子（如 sem_filter）：对表格行做自然语言过滤；MimirQ 内置实现，不依赖外部 LOTUS 包；默认关闭，避免意外产生高额 LLM 调用。
TABLE_LOTUS_ENABLED=false

# 表格语义算子处理行数上限。
TABLE_LOTUS_MAX_ROWS=20000

# 语义过滤保护阈值（防止对超大表做逐行语义判定）。
TABLE_SEM_FILTER_MAX_IN_ROWS=2000

# 表格语义过滤列数上限。
TABLE_SEM_FILTER_MAX_COLS=30

# 表格语义过滤单元格最大字符数。
TABLE_SEM_FILTER_MAX_CELL_CHARS=200

# 表格语义过滤批量大小。
TABLE_SEM_FILTER_BATCH_SIZE=25

# 是否启用对话表格问答。
CHAT_TAG_ENABLED=false

# 对话表格问答上限。
CHAT_TAG_MAX_TABLES=2

# 对话表格问答可关联的最大文档 ID 数。
CHAT_TAG_MAX_DOC_IDS=1000

# 对话表格问答上限。
CHAT_TAG_MAX_ROWS=50

# 对话表格问答上限。
CHAT_TAG_MAX_COLS=30

# 对话表格问答上限。
CHAT_TAG_MAX_BYTES=200000

# 对话表格问答的最小匹配分数。
CHAT_TAG_MIN_MATCH_SCORE=1

# LangGraph 管线配置；是否启用 LangGraph 管线（实验性）。
USE_LANGGRAPH_PIPELINE=false

# LangGraph 是否使用子图编排。
LANGGRAPH_USE_SUBGRAPHS=false

# LangGraph 最大重试次数。
RAG_GRAPH_MAX_RETRIES=2

# 查询重写配置；是否启用查询重写（将追问改写为独立问题）。
ENABLE_QUERY_REWRITE=false

# 查询重写温度参数。
QUERY_REWRITE_TEMPERATURE=0.2

# 重写后查询最大字符数。
QUERY_REWRITE_MAX_CHARS=120

# Multi-Query 扩展检索配置；是否启用 Multi-Query（生成多个等价/互补查询以提升召回）。
ENABLE_MULTI_QUERY=false

# 生成的额外查询条数（不包含原始 query）。
MULTI_QUERY_COUNT=3

# Multi-Query fanout 安全上限（默认 8；需要更激进策略时可调大，例如 40）。
MULTI_QUERY_COUNT_CAP=8

# Multi-Query 生成温度参数。
MULTI_QUERY_TEMPERATURE=0.2

# 触发 Multi-Query 的最大 query 字符数（过长则跳过）。
MULTI_QUERY_MAX_CHARS=200

# HyDE 假设文档检索配置；是否启用 HyDE（生成“假设的参考片段”用于向量检索）。
ENABLE_HYDE=false

# HyDE 生成温度参数。
HYDE_TEMPERATURE=0.2

# 触发 HyDE 的最大 query 字符数（过长则跳过）。
HYDE_MAX_CHARS=200

# HyDE 输出最大字符数（生成过长会截断）。
HYDE_OUTPUT_MAX_CHARS=800

# 问题拆解（子问题检索）配置；是否启用问题拆解（生成子问题分别检索，再融合召回）。
ENABLE_QUERY_DECOMPOSITION=false

# 最大子问题数量。
QUERY_DECOMPOSITION_MAX_SUBQUESTIONS=3

# 问题拆解生成温度参数。
QUERY_DECOMPOSITION_TEMPERATURE=0.2

# 触发问题拆解的最小 query 字符数（过短则跳过）。
QUERY_DECOMPOSITION_MIN_CHARS=60

# 触发问题拆解的最大 query 字符数（过长则跳过）。
QUERY_DECOMPOSITION_MAX_CHARS=400

# Step-Back Prompting 配置；是否启用 Step-Back（先抽象问题检索背景知识，再回答）。
ENABLE_STEP_BACK_QUERY=false

# Step-Back 生成温度参数。
STEP_BACK_TEMPERATURE=0.2

# 触发 Step-Back 的最大 query 字符数（过长则跳过）。
STEP_BACK_MAX_CHARS=200

# Step-Back 输出最大字符数（生成过长会截断）。
STEP_BACK_OUTPUT_MAX_CHARS=300

# Temporal Intelligence（时效性）配置；是否启用时效性意图识别（如“最新/目前/as of”）。
RAG_TEMPORAL_INTENT_ENABLED=false

# 是否在检测到时效性意图后对检索结果做轻量 recency rerank（不做过滤）。
RAG_TEMPORAL_INTENT_RECENCY_BOOST_ENABLED=true

# 最多参与 recency rerank 的 distinct document 数（安全上限）。
RAG_TEMPORAL_INTENT_MAX_DOCS=200

# Citation/Faithfulness 。
FAITHFULNESS_SCORE_ENABLED=true

# 忠实度分数上限。
FAITHFULNESS_SCORE_MAX_CLAIMS=24

# 忠实度分数最大证据字符数。
FAITHFULNESS_SCORE_MAX_EVIDENCE_CHARS=24000

# 句级 citation（默认关闭；开启后会在答案末尾追加引用附录）。
SENTENCE_CITATIONS_INLINE_ENABLED=false

# appendix: 追加“Sentence Citations”附录（默认）；inline: 将答案改写为逐句+引用括号（需要 claim-check）。
SENTENCE_CITATIONS_INLINE_STYLE=appendix

# 句级引用内联条目上限。
SENTENCE_CITATIONS_INLINE_MAX_ITEMS=8

# 每条声明最多附带的句级引用证据数。
SENTENCE_CITATIONS_INLINE_MAX_EVIDENCE_PER_CLAIM=2

# Corrective RAG（自愈闭环）配置；是否启用 Corrective RAG：当证据不足或 faithfulness 低时，自动加强检索并重试一次。
RAG_CORRECTIVE_ENABLED=false

# 最大尝试次数（包含第一次）；建议 2。
RAG_CORRECTIVE_MAX_ATTEMPTS=2

# faithfulness 低于该阈值时触发重试（0-1）。
RAG_CORRECTIVE_MIN_FAITHFULNESS_SCORE=0.75

# 第二轮检索使用的 retrieval_profile（recall20/recall50/coverage80/hierarchy_recall20_expand 等）。
RAG_CORRECTIVE_SECOND_PASS_PROFILE=recall50

# 第二轮是否强制启用 Multi-Query（即使全局 ENABLE_MULTI_QUERY=false 也可生效）。
RAG_CORRECTIVE_SECOND_PASS_ENABLE_MULTI_QUERY=true

# 第二轮 Multi-Query 的 query 数（受 MULTI_QUERY_COUNT_CAP 限制）。
RAG_CORRECTIVE_SECOND_PASS_MULTI_QUERY_COUNT=5

# ----------------------------------------------------------------------------
# 07｜解析器、OCR、DeepDoc 与 MagicPDF
# ----------------------------------------------------------------------------
# 文档解析器、OCR、MagicPDF、DeepDoc 小模型和解析质量门禁相关。
# ----------------------------------------------------------------------------

# Office/HTML -> Markdown（高质量：Pandoc / LibreOffice）；Pandoc（优先用于 docx/pptx/html；可提取图片到本地并输出 Markdown 引用）。
PANDOC_ENABLED=false

# Pandoc 命令路径。
PANDOC_CLI=pandoc

# Pandoc 转换超时时间（秒）。
PANDOC_TIMEOUT_SEC=180

# 输出格式：gfm（推荐）/ markdown / commonmark 等。
PANDOC_TO_FORMAT=gfm

# Pandoc Markdown 换行策略。
PANDOC_WRAP=none

# docx/pptx 时提取嵌入图片到 `media/` 并在 Markdown 中引用。
PANDOC_EXTRACT_MEDIA=true

# HTML：先用 readability 提取主体，再交给 pandoc 转 Markdown（更干净）。
PANDOC_HTML_USE_READABILITY=true

# LibreOffice（用于 .doc/.ppt/.xls 等旧格式转换；非常重，但质量通常更稳）。
LIBREOFFICE_ENABLED=false

# LibreOffice 命令路径。
LIBREOFFICE_CLI=soffice

# LibreOffice 转换超时时间（秒）。
LIBREOFFICE_TIMEOUT_SEC=300

# MinerU PDF 高级解析；在线 API 或本地服务二选一，私有部署建议本地服务。
MINERU_ENABLED=false

# MinerU API Token（从 https://mineru.net 获取）。
MINERU_API_TOKEN=

# MinerU API 基础地址。
MINERU_API_BASE=https://mineru.net/api/v4

# MinerU 在线 API 模型版本（vlm / ocr）；本地 pipeline 不依赖这个值。
MINERU_MODEL_VERSION=vlm

# MinerU 本地后端模式：pipeline 使用本地 API 内置管线；vlm-http-client 会调用独立 VLM 服务。
MINERU_BACKEND=pipeline

# MinerU 模型来源（local / huggingface / modelscope）。
MINERU_MODEL_SOURCE=local

# MinerU 本地 API 地址。Docker 后端用 http://mimirq-mineru:8000，本机后端用 http://localhost:30001。
MINERU_LOCAL_SERVER_URL=

# MinerU VLM 服务地址，仅在 MINERU_BACKEND=vlm-http-client 时使用。Docker 后端用 http://mimirq-mineru-vlm:30000，本机后端用 http://localhost:30002。
MINERU_VL_SERVER=

# MinerU VLM 服务显存占用比例。单张 48GB GPU 与 PaddleVL / olmOCR 共存时建议 0.45。
MINERU_VLM_GPU_MEMORY_UTILIZATION=0.45

# MinerU 本地 API 允许 Docker 内部 VLM HTTP 后端请求。生产环境只暴露给内网或反向代理鉴权后再开启。
MINERU_API_ALLOW_PUBLIC_HTTP_CLIENT=1

# 是否启用 DeepSeek OCR 解析器（DEFAULT_PARSER_BACKEND=deepseek_ocr）。
DEEPSEEK_OCR_ENABLED=false

# SiliconFlow API 密钥。
SILICONFLOW_API_KEY=

# SiliconFlow API 地址。
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# 模型名称。
DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR

# OCR 请求超时（秒）。
DEEPSEEK_OCR_TIMEOUT_SEC=120

# OCR 输出最大 tokens。
DEEPSEEK_OCR_MAX_TOKENS=4096

# 温度参数（一般建议偏低）。
DEEPSEEK_OCR_TEMPERATURE=0.1

# PDF 渲染 DPI（扫描件可适当提高）。
DEEPSEEK_OCR_PDF_DPI=200

# 并发页数（1 = 顺序；提高可显著加速但可能触发限流）。
DEEPSEEK_OCR_CONCURRENCY=1

# 在输出 Markdown 顶部插入每页渲染图片（即使 OCR 仅返回文本，也能在预览看到图片）。
DEEPSEEK_OCR_INCLUDE_PAGE_IMAGES=true

# 最多插入前 N 页图片（0 = 不限制）。
DEEPSEEK_OCR_PAGE_IMAGE_MAX_PAGES=0

# 插入图片格式：jpg 或 png。
DEEPSEEK_OCR_PAGE_IMAGE_FORMAT=jpg

# ETL4LLM（版面/表格/图片解析：etl4llm 服务）；是否启用 ETL4LLM 解析器（DEFAULT_PARSER_BACKEND=etl4llm）。
ETL4LLM_ENABLED=false

# ETL4LLM 服务地址。
ETL4LLM_API_URL=

# 请求超时（秒）。
ETL4LLM_TIMEOUT_SEC=120

# 返回模式：partition（含结构化 partitions）或 text（纯文本）。
ETL4LLM_MODE=partition

# 强制 OCR（适合扫描件，但更慢）。
ETL4LLM_FORCE_OCR=false

# 启用公式识别（如服务支持）。
ETL4LLM_ENABLE_FORMULA=true

# 若 partitions 含 Image 元素，则从 PDF 中裁剪图片并输出 `![](images/<id>.png)` 引用。
ETL4LLM_EXTRACT_IMAGES=true

# 尝试过滤页眉/页脚（依赖服务返回的 type）。
ETL4LLM_FILTER_PAGE_HEADER_FOOTER=false

# 若服务未返回图片引用，则在输出顶部补充每页渲染图（用于预览出图）。
ETL4LLM_INCLUDE_PAGE_IMAGES_IF_EMPTY=true

# 补图渲染 DPI。
ETL4LLM_PAGE_IMAGE_DPI=150

# 最多补图页数（0 = 不限制）。
ETL4LLM_PAGE_IMAGE_MAX_PAGES=20

# Marker（PDF -> Markdown 外部解析服务）；是否启用 Marker 解析器（DEFAULT_PARSER_BACKEND=marker）。
MARKER_ENABLED=false

# Marker 服务地址，例如本机 http://localhost:2080/convert，Docker 内 http://mimirq-marker:2080/convert。
MARKER_API_URL=

# 请求超时（秒）。
MARKER_TIMEOUT_SEC=600

# PaddleOCR-VL（PDF -> Markdown 外部 OCR/版面解析服务）；是否启用 PaddleOCR-VL 解析器（DEFAULT_PARSER_BACKEND=paddle_vl）。
PADDLE_VL_ENABLED=false

# PaddleOCR-VL 服务地址，例如本机 http://localhost:9030/convert，Docker 内 http://mimirq-paddlevl:9030/convert。
PADDLE_VL_API_URL=

# PaddleOCR 设备（推荐 GPU 容器：gpu:0）。
PADDLEOCR_DEVICE=gpu:0

# PaddleX 官方模型下载源。国内/253 推荐 aistudio，避免 HuggingFace 冷启动拉取超时。
PADDLE_PDX_MODEL_SOURCE=aistudio

# PaddleX 模型缓存目录；compose 会挂载命名卷到该目录，避免重建 PaddleVL 后重新拉模型。
PADDLE_PDX_CACHE_HOME=/home/paddleocr/.paddlex

# PaddleOCR-VL 容器内 doc_parser 超时时间（秒），应低于 PADDLE_VL_TIMEOUT_SEC，避免客户端超时后残留 GPU 子进程。
PADDLEOCR_PIPELINE_TIMEOUT_SEC=540

# 请求超时（秒）。
PADDLE_VL_TIMEOUT_SEC=600

# olmOCR（PDF -> Markdown 外部 OCR 服务）；是否启用 olmOCR 解析器（DEFAULT_PARSER_BACKEND=olmocr）。
OLMOCR_ENABLED=false

# olmOCR 服务地址，例如本机 http://localhost:2085/convert，Docker 内 http://mimirq-olmocr:2085/convert。
OLMOCR_API_URL=

# 请求超时（秒）。
OLMOCR_TIMEOUT_SEC=1800

# olmOCR 本地 vLLM 显存占用比例。单张 48GB GPU 与 MinerU VLM 共存时建议 0.35。
OLMOCR_GPU_MEMORY_UTILIZATION=0.35

# olmOCR 本地 vLLM 最大上下文长度；olmOCR 会请求约 8000 输出 token，低于 8192 会失败。
OLMOCR_MAX_MODEL_LEN=8192

# olmOCR pipeline 并发请求数。单 GPU 建议 1，避免与 MinerU/PaddleVL 争抢显存。
OLMOCR_PIPELINE_MAX_CONCURRENT_REQUESTS=1

# olmOCR 健康检查要求的最小空闲显存 GiB。
OLMOCR_MIN_FREE_GPU_GIB=8

# Qianfan-OCR（PDF/Image -> Markdown 外部 OCR 服务）；是否启用 Qianfan-OCR 解析器（DEFAULT_PARSER_BACKEND=qianfan_ocr）。
QIANFAN_OCR_ENABLED=false

# Qianfan-OCR 服务地址，例如本机 http://localhost:2090/convert，Docker 内 http://mimirq-qianfanocr:2090/convert。
QIANFAN_OCR_API_URL=

# 在线千帆上游地址；使用百度智能云千帆 API 时填 https://qianfan.baidubce.com/v2。
QIANFAN_OCR_SERVER_URL=https://qianfan.baidubce.com/v2

# 在线千帆 API Key；只写入本机或服务器 .env，不要提交真实密钥。
QIANFAN_OCR_SERVER_API_KEY=

# 在线千帆 OCR 模型名称；本地 vLLM 部署时可改为 baidu/Qianfan-OCR。
QIANFAN_OCR_MODEL=deepseek-ocr

# 单个 OCR 上游请求超时（秒）。
QIANFAN_OCR_REQUEST_TIMEOUT_SEC=120

# PDF 每页转图后的并发请求数；在线 API 建议从 1 开始，避免触发限流。
QIANFAN_OCR_PAGE_CONCURRENCY=1

# PDF 转图片 DPI。
QIANFAN_OCR_PDF_DPI=200

# OCR 提示词；留空时在线千帆使用短 OCR 提示，本地 OpenAI-compatible 服务使用 Markdown 转换提示。
QIANFAN_OCR_PROMPT=

# 请求超时（秒）。
QIANFAN_OCR_TIMEOUT_SEC=1800

# 是否启用 Layout-as-Thought 模式（由服务端按配置解释）。
QIANFAN_OCR_LAYOUT_AS_THOUGHT=false

# TextIn xParse（文档 -> Markdown 外部 API 解析服务）。
TEXTIN_ENABLED=false

# TextIn xParse API 地址。
TEXTIN_API_URL=https://api.textin.com/ai/service/v1/pdf_to_markdown

# TextIn App ID。
TEXTIN_APP_ID=

# TextIn Secret Code。
TEXTIN_SECRET_CODE=

# TextIn 请求超时时间（秒）。
TEXTIN_TIMEOUT_SEC=180

# TextIn 解析模式。
TEXTIN_PARSE_MODE=auto

# TextIn 表格输出格式。
TEXTIN_TABLE_FLAVOR=html

# TextIn 是否应用文档树结构。
TEXTIN_APPLY_DOCUMENT_TREE=true

# TextIn 是否输出 Markdown 细节。
TEXTIN_MARKDOWN_DETAILS=true

# TextIn 图片获取模式。
TEXTIN_GET_IMAGE=none

# TextIn 渲染 DPI。
TEXTIN_DPI=144

# TextIn 解析页数上限，0 表示不限制。
TEXTIN_PAGE_COUNT=0

# 文档解析器配置；默认解析后端（auto / basic / deepdoc / mineru / deepseek_ocr / qianfan_ocr / etl4llm / marker / paddle_vl / olmocr / markitdown / docling / magicpdf）。
DEFAULT_PARSER_BACKEND=deepdoc

# 默认切片策略。
DEFAULT_CHUNK_STRATEGY=langchain_recursive

# Vision LLM（用于文档解析/切块的视觉解析与图表增强；默认关闭）；是否启用 Vision LLM（启用后，集成式切块器在配置 layout_recognizer 时可走 VLM 解析）。
MIMIRQ_VISION_LLM_ENABLED=false

# 视觉模型 API Key（留空则使用 LLM_API_KEY）。
MIMIRQ_VISION_LLM_API_KEY=

# 视觉模型 API Base（留空则使用 LLM_API_BASE；支持填到 /v1 或 /v1/chat/completions）。
MIMIRQ_VISION_LLM_API_BASE=

# 视觉模型名称（需要支持图片输入；例如 gpt-4o-mini）。
MIMIRQ_VISION_LLM_MODEL=gpt-4o-mini

# 单次请求超时（秒）。
MIMIRQ_VISION_LLM_TIMEOUT_SEC=120

# 最大输出 tokens。
MIMIRQ_VISION_LLM_MAX_TOKENS=4096

# 温度（0 更稳定）。
MIMIRQ_VISION_LLM_TEMPERATURE=0.0

# 是否启用 Vision RAG 读图器，把图片证据转成文本证据后再注入上下文。
MIMIRQ_VISION_RAG_READER_ENABLED=false

# 读图数量上限（越大越慢/越贵；建议 1-3）。
MIMIRQ_VISION_RAG_READER_MAX_IMAGES=2

# 单图最大字节数（base64 后体积会变大；建议 2-5MB）。
MIMIRQ_VISION_RAG_READER_MAX_IMAGE_BYTES=3000000

# 注入上下文的最大字符数（防止把一张图读出几千行导致上下文爆炸）。
MIMIRQ_VISION_RAG_READER_MAX_OUTPUT_CHARS=1500

# Vision-native RAG（Vision generation；可选，默认关闭）；用途：当注入了图片证据时，直接用 Vision LLM 作为最终回答模型（而不是先读图再走文本模型）；这是更接近 “Vision-native” 的范式，但成本/延迟会更高。
MIMIRQ_VISION_RAG_GENERATION_ENABLED=false

# 最多附带多少张图片进生成请求（建议 1-3）。
MIMIRQ_VISION_RAG_GENERATION_MAX_IMAGES=2

# 单图最大字节数（base64 后体积会变大；建议 2-5MB）。
MIMIRQ_VISION_RAG_GENERATION_MAX_IMAGE_BYTES=3000000

# 是否启用 DeepDoc 解析器。
DEEPDOC_ENABLED=true

# 是否启用 DeepDoc 印章识别增强（对 PDF 额外补充 seal chunk；默认关闭）。
SEAL_RECOGNITION_ENABLED=false

# TrOCR Seal Recognition ONNX 模型目录（需包含 encoder_model.onnx / decoder_model.onnx / vocab.json；留空时回退到仓库内置 DeepDoc 模型）。
SEAL_RECOGNITION_MODEL_DIR=

# 印章识别平均 token 置信度阈值。
SEAL_RECOGNITION_THRESHOLD=0.88

# 渲染 PDF 页面的 DPI（越高越清晰，但越慢）。
SEAL_RECOGNITION_PDF_DPI=144

# 最多扫描多少页（0 = 全部页）。
SEAL_RECOGNITION_MAX_PAGES=0

# 每页最多尝试识别多少个印章候选区。
SEAL_RECOGNITION_MAX_REGIONS_PER_PAGE=3

# 是否启用 Docling 解析器（结构化解析）。
DOCLING_ENABLED=true

# Docling 是否启用 OCR（扫描件可尝试开启）。
DOCLING_OCR_ENABLED=true

# Docling 表格输出格式（markdown / html / plain）。
DOCLING_TABLE_MODE=markdown

# 是否抽取表格/图片裁剪图（会生成额外图片 chunk，用于预览/入库）。
DOCLING_EXTRACT_IMAGES=true

# 若 Docling 未输出图片段，则在输出顶部补充每页渲染图（用于预览出图）。
DOCLING_INCLUDE_PAGE_IMAGES_IF_EMPTY=true

# 最多补图页数（0 = 不限制）。
DOCLING_PAGE_IMAGE_MAX_PAGES=20

# 是否启用 MarkItDown 解析器（微软文档转换）。
MARKITDOWN_ENABLED=true

# 是否启用 MagicPDF（推荐使用独立服务；本地 CLI 仅作为开发/调试兜底）。
MAGIC_PDF_ENABLED=false

# MagicPDF 独立服务地址（Docker 推荐：http://mimirq-magicpdf:2095/convert）。
MAGIC_PDF_API_URL=

# 调用 MagicPDF 独立服务的超时（秒）。
MAGIC_PDF_REQUEST_TIMEOUT_SEC=600

# MagicPDF 服务端并发上限（单 GPU 建议 1）。
MAGIC_PDF_MAX_CONCURRENT_JOBS=1

# magic-pdf CLI 路径（默认在 PATH 中查找 magic-pdf）。
MAGIC_PDF_CLI=magic-pdf

# 解析方法（auto / ocr / txt）。
MAGIC_PDF_METHOD=auto

# 可选：PDF 语言（PaddleOCR 语言缩写，例如中文 "ch"）。
MAGIC_PDF_LANG=

# Docker 独立服务默认建议使用 GPU；本地 CLI/无 GPU 环境可改为 cpu。
MAGIC_PDF_DEVICE_MODE=cuda

# 是否输出 debug 产物（bbox/pdf/json 等）。
MAGIC_PDF_DEBUG=false

# 单次解析超时（秒）。
MAGIC_PDF_TIMEOUT_SEC=600

# MagicPDF 独立服务内部 magic-pdf 进程超时（秒）。
MAGIC_PDF_PIPELINE_TIMEOUT_SEC=600

# PDF-Extract-Kit 模型目录；Docker 服务默认复用 mineru_cache 的 /opt/mimirq-model-cache。
MAGIC_PDF_MODELS_DIR=

# 是否保留解析产物目录（默认会在入库流程完成后 best-effort 清理）。
MAGIC_PDF_KEEP_ARTIFACTS=false

# MinerU tools 配置 JSON 路径或内容。
MINERU_TOOLS_CONFIG_JSON=

# MarkItDown 是否使用插件。
MARKITDOWN_USE_PLUGINS=false

# MarkItDown DocIntel 端点（可选，Azure 文档智能）。
MARKITDOWN_DOCINTEL_ENDPOINT=

# MarkItDown DocIntel 密钥。
MARKITDOWN_DOCINTEL_KEY=

# 是否启用 RapidOCR（PDF 扫描件识别；开启后会对前几页做一次轻量 OCR 采样，用于提升 `auto` 路由准确性）。
RAPIDOCR_ENABLED=false

# 是否启用 LlamaIndex 切块器。
LLAMA_INDEX_ENABLED=false

# ----------------------------------------------------------------------------
# 08｜数据治理、解析回退与重排
# ----------------------------------------------------------------------------
# 文本治理、脱敏、质量过滤、解析回退、Reranker 和证据重排相关。
# ----------------------------------------------------------------------------

# 数据治理配置（文本清洗）；是否启用数据治理。
GOVERNANCE_ENABLED=false

# 是否移除目录行。
GOVERNANCE_REMOVE_TOC_LINES=true

# 是否移除噪音行（特殊符号过多的行）。
GOVERNANCE_REMOVE_NOISE_LINES=true

# 是否解包换行（合并被换行符打断的句子）。
GOVERNANCE_UNWRAP_LINES=true

# 是否移除跨文档重复行。
GOVERNANCE_REMOVE_COMMON_LINES=true

# 解包换行的最大行长度。
GOVERNANCE_UNWRAP_MAX_LINE_LENGTH=120

# 噪音行最小字符数。
GOVERNANCE_NOISE_MIN_CHARS=2

# 噪音行特殊字符比例阈值。
GOVERNANCE_NOISE_RATIO_THRESHOLD=0.2

# 重复行最少出现文档数。
GOVERNANCE_COMMON_LINES_MIN_DOCS=3

# 重复行最少出现比例。
GOVERNANCE_COMMON_LINES_MIN_RATIO=0.35

# 可选：更强的数据治理能力（默认关闭，按需打开）；是否移除常见 boilerplate 块（免责声明/版权/导航等）。
GOVERNANCE_REMOVE_BOILERPLATE=false

# 图片处理：none / decorative / all。
GOVERNANCE_REMOVE_IMAGES=none

# Markdown frontmatter 元数据提取（--- ... ---）。
GOVERNANCE_EXTRACT_FRONTMATTER=false

# 是否在提取后从内容中移除 frontmatter（避免入库索引 YAML）。
GOVERNANCE_STRIP_FRONTMATTER=false

# 语言/脚本检测（zh/en/mixed；仅写入 metadata，不改文本）。
GOVERNANCE_DETECT_LANGUAGE=false

# 数据治理语言下限。
GOVERNANCE_LANGUAGE_MIN_CHARS=40

# URL 规范化（用于一致性/去重；例如去掉 utm_* 追踪参数）。
GOVERNANCE_NORMALIZE_URLS=false

# URL 规范化时是否移除追踪参数。
GOVERNANCE_NORMALIZE_URLS_STRIP_TRACKING=true

# 段落级重复块移除（适用于页眉页脚/免责声明在每页重复的情况）。
GOVERNANCE_DROP_DUPLICATE_PARAGRAPHS=false

# 数据治理丢弃重复段落下限。
GOVERNANCE_DROP_DUPLICATE_PARAGRAPHS_MIN_OCCURRENCES=3

# 数据治理丢弃重复段落下限。
GOVERNANCE_DROP_DUPLICATE_PARAGRAPHS_MIN_CHARS=40

# 数据治理丢弃重复段落上限。
GOVERNANCE_DROP_DUPLICATE_PARAGRAPHS_MAX_CHARS=1200

# 参考文献/引用列表裁剪（best-effort；尾部 References/参考文献）。
GOVERNANCE_TRIM_REFERENCES=false

# 关键词抽取（best-effort；仅写入 metadata）。
GOVERNANCE_EXTRACT_KEYWORDS=false

# 数据治理关键词提供方。
GOVERNANCE_KEYWORDS_PROVIDER=auto

# 数据治理关键词抽取 Top-K。
GOVERNANCE_KEYWORDS_TOP_K=10

# 数据治理关键词上限。
GOVERNANCE_KEYWORDS_MAX_CHARS=20000

# 规范化 Markdown 表格（pipe table 对齐/修剪）。
GOVERNANCE_NORMALIZE_TABLES=false

# 清理 fenced code block 内的行号前缀（启发式 best-effort）。
GOVERNANCE_STRIP_CODE_LINE_NUMBERS=false

# 可选：PII 匿名化（与全局 PII middleware 独立）。
GOVERNANCE_PII_ANONYMIZE=false

# 个人敏感信息处理模式。
GOVERNANCE_PII_MODE=mask

# 个人敏感信息遮罩文本。
GOVERNANCE_PII_MASK=[REDACTED]

# 可选：敏感密钥/Token 脱敏（API Key / Bearer / 私钥块等）。
GOVERNANCE_SECRETS_REDACT=false

# 密钥信息处理模式。
GOVERNANCE_SECRETS_MODE=mask

# 密钥信息遮罩文本。
GOVERNANCE_SECRETS_MASK=[SECRET]

# 可选：段落空行控制（切块对空行敏感）。
GOVERNANCE_MAX_BLANK_LINES=1

# 可选：HTML 提取（仅 .html/.htm；XPath 如：//article | //main）。
GOVERNANCE_HTML_XPATH=

# 可选：质量过滤（触发则跳过入库并标记 failed=filtered_by_governance）。
GOVERNANCE_DROP_OUTLINE_ONLY=false

# 仅目录文档过滤的最小正文字符数。
GOVERNANCE_DROP_OUTLINE_MIN_CONTENT_CHARS=200

# 仅目录文档过滤的最大标题占比。
GOVERNANCE_DROP_OUTLINE_MAX_HEADING_RATIO=0.85

# 是否过滤低信息密度文档。
GOVERNANCE_DROP_LOW_DENSITY=false

# 低信息密度过滤阈值。
GOVERNANCE_DROP_LOW_DENSITY_THRESHOLD=0.12

# 可选：当质量过滤触发时，将文档标记为 quarantined（而不是 failed）。
GOVERNANCE_QUARANTINE_ON_DROP=false

# 解析回退（仅 PDF；parser_backend=auto 且输出质量过低时尝试其它后端）。
PARSE_FALLBACK_ENABLED=false

# 解析兜底最小CONTENT字符数。
PARSE_FALLBACK_MIN_CONTENT_CHARS=120

# 解析兜底上限。
PARSE_FALLBACK_MAX_RETRIES=1

# 持久化解析内容（用于审计/回溯；会写入 document_parsed_contents 表）。
PERSIST_PARSED_CONTENT=false

# 持久化解析内容的最大字符数。
PERSIST_PARSED_CONTENT_MAX_CHARS=200000

# 跨文档近似去重（SimHash；best-effort，默认关闭）。
NEAR_DEDUP_ENABLED=false

# 近似去重HAMMING阈值。
NEAR_DEDUP_HAMMING_THRESHOLD=3

# 近似去重最大桶大小。
NEAR_DEDUP_MAX_BUCKET_SIZE=256

# Reranker 重排序配置；是否启用 Reranker（对检索结果重排序提升质量）。
ENABLE_RERANKER=false

# Reranker 提供商；默认预置硅基流动 OpenAI 兼容接口，但不开启额外在线调用。
RERANKER_PROVIDER=openai

# Reranker 模型名称。
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Reranker API 密钥；留空时复用 LLM_API_KEY。
RERANKER_API_KEY=

# Reranker API 基础地址。
RERANKER_API_BASE=https://api.siliconflow.cn/v1/rerank

# Reranker 候选数量。
RERANKER_TOP_N=20

# Reranker 单条最大字符数。
RERANKER_MAX_CHARS=800

# Reranker 温度参数。
RERANKER_TEMPERATURE=0.0

# 本地模型 Reranker 的首次加载最长等待秒数；超时后快速降级，避免在线请求卡住模型下载。
RERANKER_LOCAL_LOAD_TIMEOUT_SEC=2.0

# 本地 LTR（Learning-to-Rank）模型（可选：reranker_provider=ltr 或 Evidence post-rerank 使用）。
LTR_MODEL_PATH=

# 可选：LTR 模型 sidecar manifest（JSON）；为空时会自动读取 `<LTR_MODEL_PATH>.manifest.json`（如存在）。
LTR_MODEL_MANIFEST_PATH=

# LTR 特征版本（必须与模型 artifact 的 feature_names 顺序/数量一致）。
LTR_FEATURE_SPEC_VERSION=1

# API Reranker 工程化参数（批量/并发/限流/熔断/缓存）；API 调用超时（秒）。
RERANKER_API_TIMEOUT_SEC=30

# 单次请求批量大小。
RERANKER_API_BATCH_SIZE=32

# 最大并发（对 async/多批次生效）。
RERANKER_API_MAX_CONCURRENCY=4

# 阻塞检索任务的进程内并发上限；默认 1，部署环境应压测后再提高。
RAG_RETRIEVAL_OFFLOAD_MAX_CONCURRENCY=1

# 等待检索并发槽位的最长秒数；超时返回可重试 503，0 表示无限等待。
RAG_RETRIEVAL_ADMISSION_TIMEOUT_SEC=15

# 速率限制 QPS（0 关闭）。
RERANKER_API_RATE_LIMIT_QPS=0

# API 失败最大重试次数。
RERANKER_API_MAX_RETRIES=2

# 重试退避基准秒数（指数退避）。
RERANKER_API_RETRY_BACKOFF_SEC=0.5

# 熔断：连续失败阈值。
RERANKER_API_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# 熔断：打开后冷却时间（秒）。
RERANKER_API_CIRCUIT_BREAKER_RESET_SEC=60

# 缓存：是否启用（仅内存）。
RERANKER_API_CACHE_ENABLED=true

# 缓存：最大条目数。
RERANKER_API_CACHE_MAX_ENTRIES=2000

# 缓存：TTL（秒）。
RERANKER_API_CACHE_TTL_SEC=3600

# Evidence API 检索后重排序（默认关闭）：这是“证据优先”的确定性/快速重排序开关，适合 LTR/ColBERT late-interaction 等。
EVIDENCE_POST_RERANK_ENABLED=false

# 证据后置重排序提供方。
EVIDENCE_POST_RERANK_PROVIDER=ltr

# 证据后置重排序候选数量。
EVIDENCE_POST_RERANK_TOP_N=30

# 多阶段 pipeline（可选，默认关闭）。
EVIDENCE_POST_RERANK_PIPELINE_ENABLED=false

# JSON 示例（注意 shell 需要转义/加引号）。
EVIDENCE_POST_RERANK_PIPELINE=

# ----------------------------------------------------------------------------
# 09｜入库预检、URL 导入与 Office 转换
# ----------------------------------------------------------------------------
# 入库预检、本地扫描、URL 导入和 Office/HTML 转 Markdown 相关。
# ----------------------------------------------------------------------------

# 是否启用本地文件夹预检扫描。默认关闭，避免后端读取任意本地路径。
LOCAL_SCAN_ENABLED=false

# 允许扫描的根目录列表（逗号分隔）。为空时只允许扫描 UPLOAD_DIR（默认 ./uploads）下的路径。
LOCAL_SCAN_ROOTS=

# 最多扫描文件数（默认 20000）。
PRECHECK_SCAN_MAX_FILES=20000

# 最多扫描总字节数（默认 5GB）。
PRECHECK_SCAN_MAX_TOTAL_BYTES=5000000000

# 单文件抽样读取上限（默认 2MB）。
PRECHECK_TEXT_EXTRACT_MAX_BYTES=2000000

# PDF 抽样页数（默认 3）。
PRECHECK_PDF_SAMPLE_PAGES=3

# PDF 页面分类阈值：<=min_text_chars_per_page 认为是扫描页；>=text_chars_per_page 认为是文字页（其余为 low_density）。
PRECHECK_PDF_MIN_TEXT_CHARS_PER_PAGE=50

# PDF 判定为文字页的每页字符数阈值。
PRECHECK_PDF_TEXT_CHARS_PER_PAGE=200

# PDF 判定为“扫描型”的扫描页占比阈值（默认 0.7）。
PRECHECK_PDF_SCAN_RATIO_THRESHOLD=0.7

# 大型表格行数阈值（默认 5000，超过则提示优先走 TAG/SQL）。
PRECHECK_SPREADSHEET_LARGE_ROW_THRESHOLD=5000

# 宽表阈值：列数过多通常不适合纯 RAG（默认 80）。
PRECHECK_SPREADSHEET_WIDE_COL_THRESHOLD=80

# 多 Sheet 阈值：Sheet 数过多通常需要结构化处理或拆分（默认 5）。
PRECHECK_SPREADSHEET_SHEET_THRESHOLD=5

# 合并单元格占比阈值：合并单元格过多通常意味着“表格结构复杂”（默认 0.15）。
PRECHECK_SPREADSHEET_MERGED_RATIO_THRESHOLD=0.15

# 是否启用 URL 导入。该能力由服务端发起网络请求，生产环境建议关闭或配置 allowlist / egress firewall。
URL_INGEST_ENABLED=false

# 单个 URL 最大下载大小（字节，默认与 MAX_FILE_SIZE 一致）。
URL_INGEST_MAX_BYTES=50000000

# 下载超时（秒）。
URL_INGEST_TIMEOUT_SEC=30.0

# 是否允许服务端访问内网/私网 IP（URL 导入与 LLM 连通测试共用；强烈不建议在公网开启）。
URL_INGEST_ALLOW_PRIVATE_IPS=false

# 是否允许跟随重定向（可能跳转到内网/大文件）。
URL_INGEST_FOLLOW_REDIRECTS=false

# ----------------------------------------------------------------------------
# 10｜知识图谱、对话记忆与多租户
# ----------------------------------------------------------------------------
# 知识图谱、KG 增强检索、对话记忆和租户请求头相关。
# ----------------------------------------------------------------------------

# KG 知识图谱配置；是否启用 KG（事件/实体抽取）。
KG_ENABLED=false

# 是否在对话中启用 KG 增强检索。
KG_CHAT_ENABLED=false

# KG 在线服务层预算。全量 KG 仍会保存；普通 RAG 检索默认只把高价值事件子集送入扩展和重排，避免长文档或噪声分块拖慢问答。
KG_SEARCH_SERVING_LAYER_ENABLED=true

# 每个分块最多进入在线 KG 检索的事件数，0 表示不按分块限制。
KG_SEARCH_SERVING_MAX_EVENTS_PER_CHUNK=2

# 每篇文档最多进入在线 KG 检索的事件数，0 表示不按文档限制。
KG_SEARCH_SERVING_MAX_EVENTS_PER_DOCUMENT=80

# 在线 KG 检索候选事件最低分，0 表示只按数量预算筛选。
KG_SEARCH_SERVING_MIN_SCORE=0.0

# 为服务层预算预取更多候选，再按分块/文档裁剪，避免裁剪后候选不足。
KG_SEARCH_SERVING_CANDIDATE_MULTIPLIER=3

# KG 社区检测 + Global Summary（GraphRAG-like global search）；仅在 query-mode 判定为 global 且命中 “overview/summary/总体/全局…” 等模式时触发（可配置）；默认关闭，避免影响普通问答延迟。
KG_COMMUNITY_ENABLED=false

# 是否仅在全局类问题命中时触发 KG 社区检索。
KG_COMMUNITY_REQUIRE_GLOBAL_PATTERN=true

# 知识图谱社区上限。
KG_COMMUNITY_MAX_EVENTS=200

# KG 社区检测中每个事件的最大实体数。
KG_COMMUNITY_MAX_ENTITIES_PER_EVENT=12

# KG 社区检测的最小边权重。
KG_COMMUNITY_MIN_EDGE_WEIGHT=2.0

# KG 社区标签传播迭代次数。
KG_COMMUNITY_LABEL_PROPAGATION_ITERS=25

# 知识图谱社区上限。
KG_COMMUNITY_MAX_COMMUNITIES=12

# KG 每个社区的最大实体数。
KG_COMMUNITY_MAX_ENTITIES_PER_COMMUNITY=12

# KG 每个社区的最大事件数。
KG_COMMUNITY_MAX_EVENTS_PER_COMMUNITY=6

# 知识图谱社区全局摘要上限。
KG_COMMUNITY_GLOBAL_SUMMARY_MAX_CHARS=3200

# 是否使用 KG 命中实体扩展检索 query。
RAG_KG_QUERY_EXPANSION_ENABLED=false

# RAG知识图谱查询扩展上限。
RAG_KG_QUERY_EXPANSION_MAX_ENTITIES=5

# RAG知识图谱查询扩展上限。
RAG_KG_QUERY_EXPANSION_MAX_QUERIES=5

# KG query 扩展的最小实体权重。
RAG_KG_QUERY_EXPANSION_MIN_ENTITY_WEIGHT=0.15

# 默认排除 SkillNet taxonomy 节点，避免 query 漂移（可按需调整；空字符串表示不排除）。
RAG_KG_QUERY_EXPANSION_EXCLUDE_ENTITY_TYPES=Skill,SkillTag,SkillCategory

# 是否把 KG 命中事件对应的 chunk 注入检索证据。
RAG_KG_CHUNK_INJECTION_ENABLED=false

# KG chunk 注入数量上限。
RAG_KG_CHUNK_INJECTION_MAX_CHUNKS=5

# KG 抽取 PromptTemplate 选择（可选；用于控制“事件/实体抽取”的提示词）；优先级：ID > template_key > ab_experiment_key；固定模板：填 PromptTemplate.id。
KG_EXTRACT_PROMPT_TEMPLATE_ID=

# 版本化 key：取该 key 下 is_active 且 version 最大的模板。
KG_EXTRACT_PROMPT_TEMPLATE_KEY=

# A/B 实验：按 ab_experiment_key 在变体间稳定分流（若能拿到 account_id 则用作 seed）。
KG_EXTRACT_PROMPT_AB_EXPERIMENT_KEY=

# KG 抽取时是否替换已有数据。
KG_EXTRACT_REPLACE_EXISTING=true

# KG 抽取后是否裁剪孤立实体。
KG_EXTRACT_PRUNE_ORPHAN_ENTITIES=true

# 对话历史配置；对话历史窗口大小（保留最近 N 轮对话）。
CHAT_HISTORY_WINDOW=5

# 是否启用长期记忆（从历史消息中检索相关上下文）。
LONG_TERM_MEMORY_ENABLED=false

# 长期记忆检索 Top-K。
LONG_TERM_MEMORY_TOP_K=3

# 长期记忆最小消息长度。
LONG_TERM_MEMORY_MIN_LEN=20

# 结构化记忆（实体/事实）：从历史 assistant turn 的 message_metadata 中提取并注入 system context（可选）；注意：需要请求里显式 `enable_structured_memory=true` 才会生效。
STRUCTURED_MEMORY_ENABLED=false

# 结构化记忆回看消息数量。
STRUCTURED_MEMORY_LOOKBACK_MESSAGES=80

# 结构化记忆上限。
STRUCTURED_MEMORY_MAX_ENTITIES=20

# 结构化记忆上限。
STRUCTURED_MEMORY_MAX_FACTS=8

# 结构化记忆最大上下文字符数。
STRUCTURED_MEMORY_MAX_CONTEXT_CHARS=1200

# 多租户配置；默认租户 ID。
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# 租户 ID 请求头名称。
TENANT_HEADER=X-Tenant-ID

# SCIM 默认关闭；启用时 bearer token 必须绑定到一个租户。
SCIM_ENABLED=false
SCIM_BEARER_TOKEN=
SCIM_TENANT_ID=

# Dify 外部知识库适配器；开启后 Dify 可以通过 HTTP 调用 MimirQ 的真实检索结果。
DIFY_EXTERNAL_KNOWLEDGE_ENABLED=false

# Dify 调用本接口使用的 Bearer Token，支持多个值用逗号分隔；生产建议使用 sha256:<hex>。
DIFY_EXTERNAL_KNOWLEDGE_API_KEYS=

# Dify 请求未携带租户头时使用的租户 ID；留空时使用 DEFAULT_TENANT_ID。
DIFY_EXTERNAL_KNOWLEDGE_TENANT_ID=

# Dify 检索请求在 MimirQ 内部使用的服务账号；需要具备目标数据集读取权限。
DIFY_EXTERNAL_KNOWLEDGE_ACCOUNT_ID=system:dify

# knowledge_id 到数据集的映射；未配置时 knowledge_id 会按单个 dataset_id UUID 处理。
# 可在映射项内声明 plugin_refs；需要复用另一个映射的 query_routes 时，显式声明 inherit_query_routes_from。
# 示例：{"shared":{"dataset_id":"dataset-uuid-a","query_routes":[]},"faq":{"dataset_id":"dataset-uuid-c","plugin_refs":["plugin:domain-knowledge-demo@1.0.0:chunk"],"inherit_query_routes_from":["shared"]}}
DIFY_EXTERNAL_KNOWLEDGE_MAP_JSON=

# 启动后预热 Dify 检索；生产环境可要求 readiness 等待预热完成，避免首个请求承担冷启动。
DIFY_EXTERNAL_KNOWLEDGE_WARMUP_ENABLED=true
DIFY_EXTERNAL_KNOWLEDGE_WARMUP_TIMEOUT_SEC=60
DIFY_EXTERNAL_KNOWLEDGE_WARMUP_REQUIRED_FOR_READY=false

# Dify 单次检索允许返回的最大记录数；默认按 Dify 命中测试的短超时预算保护。
DIFY_EXTERNAL_KNOWLEDGE_TOP_K_MAX=5

# Dify 外部知识内部候选窗口；对外仍只返回 TOP_K_MAX 内的记录，内部多取候选以提升正确内容召回。
DIFY_EXTERNAL_KNOWLEDGE_INTERNAL_TOP_K_MIN=20
DIFY_EXTERNAL_KNOWLEDGE_INTERNAL_TOP_K_MULTIPLIER=4
DIFY_EXTERNAL_KNOWLEDGE_INTERNAL_TOP_K_MAX=50

# Dify 外部知识主范围检索：非 strict route 只作为召回 hint，不会过滤聚合知识库；strict route 才作为硬范围。
DIFY_EXTERNAL_KNOWLEDGE_PRIMARY_SCOPE_ENABLED=true
DIFY_EXTERNAL_KNOWLEDGE_PRIMARY_MIN_RECORDS=1
DIFY_EXTERNAL_KNOWLEDGE_PRIMARY_MIN_TOP_SCORE=0.45

# 短时响应缓存处理顺序重复请求；singleflight 合并尚未完成的同键并发/重试请求。
DIFY_EXTERNAL_KNOWLEDGE_RESPONSE_CACHE_ENABLED=true
DIFY_EXTERNAL_KNOWLEDGE_RESPONSE_CACHE_TTL_SEC=30
DIFY_EXTERNAL_KNOWLEDGE_RESPONSE_CACHE_MAX_ENTRIES=512
DIFY_EXTERNAL_KNOWLEDGE_SINGLEFLIGHT_ENABLED=true

# 元数据锚点兜底启用时，每个质量模式请求可累计占用的 DB 时间；0 表示不限制。
DIFY_EXTERNAL_KNOWLEDGE_METADATA_ANCHOR_TOTAL_BUDGET_MS=1500

# Dify 外部知识高置信压缩：当 TOP1 明显强、后续候选分数断崖下降时，少返回低相关噪音块。
DIFY_EXTERNAL_KNOWLEDGE_COMPACT_HIGH_CONFIDENCE_ENABLED=true
DIFY_EXTERNAL_KNOWLEDGE_COMPACT_MIN_TOP_SCORE=0.7
DIFY_EXTERNAL_KNOWLEDGE_COMPACT_RELATIVE_SCORE_FLOOR=0.65
DIFY_EXTERNAL_KNOWLEDGE_COMPACT_MIN_RECORDS=1

# Dify 外部知识复合/混合意图预算：多路召回合并后统一 rerank，避免每个子查询重复 rerank。
DIFY_EXTERNAL_KNOWLEDGE_MIXED_INTENT_SUPPLEMENT_ENABLED=true
DIFY_EXTERNAL_KNOWLEDGE_MIXED_INTENT_MAX_SUBQUERIES=4
# 0 表示每个子查询沿用 Dify response top_k。
DIFY_EXTERNAL_KNOWLEDGE_MIXED_INTENT_SUBQUERY_TOP_K=0

# Dify 外部知识 KG 辅助策略：KG 不直接回答，只用于扩展查询、注入 KG 关联 chunk、提升 KG 命中 chunk 排序。
# 生效前提仍是 KG_ENABLED=true 且 KG_CHAT_ENABLED=true。
DIFY_EXTERNAL_KNOWLEDGE_KG_QUERY_EXPANSION_ENABLED=false
DIFY_EXTERNAL_KNOWLEDGE_KG_CHUNK_INJECTION_ENABLED=false
DIFY_EXTERNAL_KNOWLEDGE_KG_CHUNK_INJECTION_MAX_CHUNKS=3
DIFY_EXTERNAL_KNOWLEDGE_KG_CHUNK_BOOST_ENABLED=false
DIFY_EXTERNAL_KNOWLEDGE_KG_CHUNK_BOOST_WEIGHT=0.25
DIFY_EXTERNAL_KNOWLEDGE_KG_CHUNK_BOOST_MAX_PROMOTED=2

# ----------------------------------------------------------------------------
# 11｜日志、指标与链路观测
# ----------------------------------------------------------------------------
# 日志、Prometheus、Sentry、OpenTelemetry、工具调用日志和 PII 脱敏相关。
# ----------------------------------------------------------------------------

# 可观测性配置（Logging / Metrics / Tracing）；日志级别（DEBUG/INFO/WARNING/ERROR）。
LOG_LEVEL=INFO

# 日志格式（plain/json）。
LOG_FORMAT=plain

# Prometheus /metrics（默认关闭）。
PROMETHEUS_ENABLED=false

# Sentry（设置 DSN 后启用）。
SENTRY_DSN=

# Sentry trace 采样率。
SENTRY_TRACES_SAMPLE_RATE=0.0

# OpenTelemetry Tracing（默认关闭；需要安装 opentelemetry 相关依赖）。
OTEL_ENABLED=false

# OTEL服务名称。
OTEL_SERVICE_NAME=mimirq

# OTLP endpoint（可选；也可用标准环境变量 OTEL_EXPORTER_OTLP_ENDPOINT 配置）。
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP headers（可选；格式：k1=v1,k2=v2）。
OTEL_EXPORTER_OTLP_HEADERS=

# OTEL导出器OTLP 超时时间（秒）。
OTEL_EXPORTER_OTLP_TIMEOUT_SEC=10

# 日志与监控配置；是否启用 RAG 指标日志。
ENABLE_METRICS_LOG=false

# 指标日志文件路径。
METRICS_LOG_PATH=./logs/rag_metrics.jsonl

# 是否启用工具调用日志。
TOOL_CALL_LOG_ENABLED=false

# 工具调用日志是否包含预览内容。
TOOL_CALL_LOG_INCLUDE_PREVIEW=false

# 工具调用日志最大预览字符数。
TOOL_CALL_LOG_MAX_PREVIEW_CHARS=500

# 是否启用 Agent日志。
AGENT_LOG_ENABLED=false

# Agent日志包含执行路径。
AGENT_LOG_INCLUDE_EXECUTION_PATH=false

# Agent日志最大预览字符数。
AGENT_LOG_MAX_PREVIEW_CHARS=500

# 是否启用个人敏感信息脱敏。
PII_REDACTION_ENABLED=false

# 敏感信息脱敏后的替换文本。
PII_REDACTION_MASK=[REDACTED]

# 流式输出脱敏延迟缓冲字符数，用于降低敏感信息漏出风险。
PII_STREAM_HOLDBACK_CHARS=128
