# Copy this file to `.env` for local backend development:
#   - Windows PowerShell: Copy-Item .env.example .env
#   - macOS/Linux:       cp .env.example .env
#
# Docker Compose uses `docker/.env` (not this file).
#
# Notes:
# - Any OpenAI-compatible API is supported (OpenAI, DashScope compatible-mode, etc.).
# - If you use DashScope compatible-mode, keep `LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1`.
# - For embeddings, `EMBEDDING_PROVIDER=openai_compatible` works with compatible-mode `/v1/embeddings`.

# =========================
# Database / Vector backend
# =========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimirq
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=documents

# =========
# Auth/CORS
# =========
AUTH_MODE=header
# Required when AUTH_MODE=jwt (min 32 chars)
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===
# LLM
# ===
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
LLM_MODEL_FAST=
LLM_MODEL_HEAVY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# =========
# Embedding
# =========
# Use openai_compatible for any OpenAI-compatible embeddings endpoint (recommended).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v4
# Leave empty to reuse LLM_API_KEY/LLM_API_BASE
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# =========
# File/Zip
# =========
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
ZIP_MAX_FILES=2000
ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=500000000
ZIP_MAX_SINGLE_UNCOMPRESSED_BYTES=100000000
ZIP_MAX_IMAGES=300
MAX_INLINE_IMAGE_BYTES=10000000
MAX_INLINE_IMAGES=200
CHUNK_MIN_CHARS=30

# ==================
# Object storage (S3)
# ==================
# Enable this to persist parsed images and allow RAG citations to include `img_url`.
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mimirq
MINIO_USE_SSL=false

# =========================
# MinerU (PDF advanced parse)
# =========================
MINERU_ENABLED=false
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# =========================
# DeepSeek OCR (SiliconFlow)
# =========================
DEEPSEEK_OCR_ENABLED=false
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR
DEEPSEEK_OCR_TIMEOUT_SEC=120
DEEPSEEK_OCR_MAX_TOKENS=4096
DEEPSEEK_OCR_TEMPERATURE=0.1
DEEPSEEK_OCR_PDF_DPI=200
