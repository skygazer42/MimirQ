# ============================================================
# MimirQ 本地环境配置（最小启动模板）
# ============================================================
# 用法：
# - 本地后端开发：cp .env.example .env
# - Docker 依赖服务：cd docker && cp .env.example .env
# - 高级能力配置：按需从 config/env/*.env.example 复制对应键到 .env。

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimirq
MIMIRQ_DB_CREATE_ALL_ON_STARTUP=true
MIMIRQ_DB_RUNTIME_MIGRATIONS_ENABLED=true
POSTGRES_DB=mimirq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Frontend / local identity
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT_MS=60000
NEXT_PUBLIC_API_LONG_TIMEOUT_MS=600000
NEXT_PUBLIC_USER_ID=demo
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------
# LLM / Embedding
# ------------------------------------------------------------
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# ------------------------------------------------------------
# Vector store / object storage / uploads
# ------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=documents
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mimirq
MINIO_USE_SSL=false
MINIO_DOCUMENTS_ENABLED=false
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Auth / API server
# ------------------------------------------------------------
AUTH_MODE=header
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# RAG defaults
# ------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7
VECTOR_BACKEND=milvus
CHUNK_VECTOR_ENABLED=true
BM25_INDEX_ENABLED=true

# ------------------------------------------------------------
# Parser defaults / live parser safety
# ------------------------------------------------------------
DEFAULT_PARSER_BACKEND=deepdoc
DEFAULT_CHUNKING_STRATEGY=langchain_recursive
MINERU_ENABLED=false
DEEPSEEK_OCR_ENABLED=false
ETL4LLM_ENABLED=false
ETL4LLM_API_URL=
MAGIC_PDF_ENABLED=false

# ------------------------------------------------------------
# KG / tenancy / observability
# ------------------------------------------------------------
KG_ENABLED=false
KG_CHAT_ENABLED=false
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
TENANT_HEADER=X-Tenant-ID
LOG_LEVEL=INFO
LOG_FORMAT=plain
ENABLE_METRICS_LOG=false
METRICS_LOG_PATH=./logs/rag_metrics.jsonl
