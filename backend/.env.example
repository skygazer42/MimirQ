# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimirq

# LLM API (OpenAI-compatible)
LLM_API_KEY=sk-your-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Embeddings
# 推荐：使用 OpenAI 兼容的 API（无需下载模型）
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=  # 留空则使用 LLM_API_KEY
EMBEDDING_API_BASE=  # 留空则使用 LLM_API_BASE

# 可选：使用本地模型（需下载约 1.5GB 模型，适合离线场景）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=documents

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# MinerU Online API (https://mineru.net)
MINERU_ENABLED=false  # 设置为 true 启用高级 PDF 解析
MINERU_API_TOKEN=  # 从 https://mineru.net 官网申请
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Server
HOST=0.0.0.0
PORT=8000

# RAG Config
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7
