# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimirq

# LLM (OpenAI-compatible, supports custom base URL)
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Embeddings
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=


# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=documents

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# MinerU Online API (https://mineru.net)
MINERU_ENABLED=false
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Server
HOST=0.0.0.0
PORT=8000

# RAG Config
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7
DEFAULT_PARSER_BACKEND=auto
# Supported: langchain_recursive | langchain_token | llama_index | llama_index_hierarchical
DEFAULT_CHUNK_STRATEGY=langchain_recursive
DEEPDOC_ENABLED=false
MARKITDOWN_ENABLED=false
MARKITDOWN_USE_PLUGINS=false
MARKITDOWN_DOCINTEL_ENDPOINT=
MARKITDOWN_DOCINTEL_KEY=
LLAMA_INDEX_ENABLED=false

# Multi-tenant
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
TENANT_HEADER=X-Tenant-ID
