# ============================================================
# MimirQ Production Environment Template
# ============================================================
#
# Usage:
# 1) Copy to `.env` (or keep as `.env` on the production host)
# 2) Run: `docker compose -f docker-compose.prod.yml up -d --build`
#
# Notes:
# - `docker-compose.prod.yml` enforces `AUTH_MODE=jwt` and `ENV=production`.
# - You MUST set `SECRET_KEY` (min 32 chars) and `POSTGRES_PASSWORD`.

# ------------------------------------------------------------
# Required secrets
# ------------------------------------------------------------
SECRET_KEY=replace-with-a-random-string-at-least-32-chars

# Database (for docker-compose.prod.yml)
POSTGRES_DB=mimirq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------
# LLM / Embeddings (required for chat & indexing)
# ------------------------------------------------------------
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# ------------------------------------------------------------
# Optional: expose build metadata in `/api/v1/meta`
# ------------------------------------------------------------
MIMIRQ_BUILD_SHA=
MIMIRQ_BUILD_TIME=

# ------------------------------------------------------------
# Optional: backend runtime knobs
# ------------------------------------------------------------
BACKEND_WORKERS=2
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------
# Optional: MinIO for extracted images (NOT Milvus MinIO)
# ------------------------------------------------------------
# This is for the backend image store (document extracted images).
# If enabled, you MUST provide non-default credentials in production.
APP_MINIO_ENABLED=false
MINIO_ENDPOINT_DOCKER=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME_DOCKER=mimirq
MINIO_USE_SSL_DOCKER=false

# ------------------------------------------------------------
# Required: Milvus internal MinIO credentials (used by Milvus)
# ------------------------------------------------------------
# For a private, internal-only deployment you can keep defaults,
# but it's recommended to change them on production hosts.
MINIO_ACCESS_KEY_DOCKER=minioadmin
MINIO_SECRET_KEY_DOCKER=minioadmin

# ------------------------------------------------------------
# Frontend build-time config (only for `web` service / profile)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT_MS=60000
NEXT_PUBLIC_USER_ID=demo
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

