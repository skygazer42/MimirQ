FROM node:20-alpine AS base

RUN corepack enable && mkdir -p /app && chown -R node:node /app
WORKDIR /app

FROM base AS deps
USER node
COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS builder
USER node
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node app ./app
COPY --chown=node:node components ./components
COPY --chown=node:node contexts ./contexts
COPY --chown=node:node hooks ./hooks
COPY --chown=node:node lib ./lib
COPY --chown=node:node public ./public
COPY --chown=node:node services ./services
COPY --chown=node:node store ./store
COPY --chown=node:node types ./types
COPY --chown=node:node workers ./workers
COPY --chown=node:node next.config.mjs next-env.d.ts openapi.json postcss.config.mjs tailwind.config.ts tsconfig.json ./
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_API_TIMEOUT_MS=60000
ARG NEXT_PUBLIC_API_LONG_TIMEOUT_MS=600000
ARG NEXT_PUBLIC_USER_ID=demo
ARG NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000
ARG MIMIRQ_BUILD_SHA=""
ARG MIMIRQ_BUILD_TIME=""
ENV NODE_ENV=production
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_TIMEOUT_MS=$NEXT_PUBLIC_API_TIMEOUT_MS
ENV NEXT_PUBLIC_API_LONG_TIMEOUT_MS=$NEXT_PUBLIC_API_LONG_TIMEOUT_MS
ENV NEXT_PUBLIC_USER_ID=$NEXT_PUBLIC_USER_ID
ENV NEXT_PUBLIC_TENANT_ID=$NEXT_PUBLIC_TENANT_ID
RUN pnpm build && pnpm prune --prod

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_API_TIMEOUT_MS=60000
ARG NEXT_PUBLIC_API_LONG_TIMEOUT_MS=600000
ARG NEXT_PUBLIC_USER_ID=demo
ARG NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000
ARG MIMIRQ_BUILD_SHA=""
ARG MIMIRQ_BUILD_TIME=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_TIMEOUT_MS=$NEXT_PUBLIC_API_TIMEOUT_MS
ENV NEXT_PUBLIC_API_LONG_TIMEOUT_MS=$NEXT_PUBLIC_API_LONG_TIMEOUT_MS
ENV NEXT_PUBLIC_USER_ID=$NEXT_PUBLIC_USER_ID
ENV NEXT_PUBLIC_TENANT_ID=$NEXT_PUBLIC_TENANT_ID
ENV MIMIRQ_BUILD_SHA=$MIMIRQ_BUILD_SHA
ENV MIMIRQ_BUILD_TIME=$MIMIRQ_BUILD_TIME

COPY --from=builder --chown=node:node --chmod=0444 /app/package.json ./package.json
COPY --from=builder --chown=node:node --chmod=0444 /app/next.config.mjs ./next.config.mjs
COPY --from=builder --chown=node:node --chmod=0555 /app/public ./public
COPY --from=builder --chown=node:node --chmod=0555 /app/.next_build ./.next_build
COPY --from=builder --chown=node:node --chmod=0555 /app/node_modules ./node_modules

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/ > /dev/null || exit 1

USER node
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
