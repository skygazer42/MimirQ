{
  "name": "mimirq-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:turbo": "next dev --turbo -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "api-check": "node scripts/check-api-contract.mjs && node scripts/check-api-coverage.mjs",
    "openapi:export": "python3 ../scripts/export_openapi.py --out openapi.json",
    "openapi-types": "pnpm run openapi:export && pnpm run gen:api-types",
    "gen:api-types": "openapi-typescript ./openapi.json -o types/openapi.ts"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.6.7",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "comlink": "^4.4.2",
    "framer-motion": "^12.26.2",
    "jszip": "^3.10.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.562.0",
    "minisearch": "^7.2.0",
    "next": "^16.1.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.0",
    "react-force-graph-3d": "^1.29.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-tsparticles": "^2.12.2",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "textarea-caret": "^3.1.0",
    "three": "^0.182.0",
    "three-spritetext": "^1.10.0",
    "tsparticles-engine": "^2.12.0",
    "tsparticles-slim": "^2.12.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.3",
    "openapi-typescript": "7.10.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3"
  }
