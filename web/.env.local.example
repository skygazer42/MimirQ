NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_CONTACT_URL=https://github.com/skygazer42/MimirQ/issues
NEXT_PUBLIC_API_TIMEOUT_MS=60000
NEXT_PUBLIC_API_LONG_TIMEOUT_MS=600000
NEXT_PUBLIC_USER_ID=demo
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Server-side only; make init generates this for opaque remote-image proxy URLs.
MARKDOWN_IMAGE_PROXY_SECRET=

# Server-side only (optional): when the Next.js server runs in a container,
# it cannot reach the backend via http://localhost:8000 (localhost = itself).
# Use a container-to-container URL instead (this is NOT exposed to the browser).
# API_INTERNAL_URL=http://mimirq-api:8000

# 可选：你也可以把这两个写进 localStorage（优先级更高）
# - mimirq_user_id
# - mimirq_tenant_id

# Optional: OIDC SSO (Authorization Code + PKCE)
# When configured, /auth shows a "Continue with SSO" button.
NEXT_PUBLIC_OIDC_ENABLED=true
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPES=openid profile email
# Optional override (default: <origin>/auth/oidc/callback)
NEXT_PUBLIC_OIDC_REDIRECT_URI=
# Optional extra auth params (querystring without '?', e.g. audience=...&prompt=login)
NEXT_PUBLIC_OIDC_AUTH_PARAMS=
