{
  "schema": "mimirq.retrieval_policy.v1",
  "query_expansion_fields": [
    "service_name",
    "service_aliases",
    "case_title",
    "case_key",
    "retrieval_intents",
    "related_services",
    "materials",
    "operation_steps",
    "question",
    "aliases",
    "primary_alias",
    "keywords",
    "title",
    "source_topic",
    "category_path",
    "category_leaf",
    "applicable_area"
  ],
  "query_expansion_values": [
    {"metadata": "section_type", "value": "related_services", "terms": ["涉及事项", "包含哪些事项", "联办事项"]},
    {"metadata": "section_type", "value": "process", "terms": ["办理须知", "办理流程", "怎么办理"]},
    {"metadata": "section_type", "value": "materials", "terms": ["申请材料", "办理材料", "需要哪些材料", "材料清单"]},
    {"metadata": "section_type", "value": "channels", "terms": ["办理渠道", "在哪里办理", "线上办理入口"]},
    {"metadata": "section_type", "value": "operation_entry", "terms": ["系统入口", "办理入口", "从哪里进入办理"]},
    {"metadata": "section_type", "value": "operation_steps", "terms": ["申报流程", "申报步骤", "网上办理怎么操作", "操作步骤"]},
    {"metadata": "section_type", "value": "operation_material_upload", "terms": ["材料上传", "上传材料", "附件上传"]},
    {"metadata": "section_type", "value": "operation_query", "terms": ["进度查询", "结果查询", "查询办理进度"]},
    {"metadata": "section_type", "value": "operation_url", "terms": ["在线入口", "网上办理地址", "操作手册入口"]},
    {"metadata": "section_type", "value": "operation_notes", "terms": ["备注", "注意事项", "办理注意事项"]}
  ],
  "filter_fields": [
    "gov_knowledge_plugin",
    "gov_knowledge_type",
    "knowledge_section",
    "source_record_id",
    "chunk_kind",
    "service_name",
    "case_title",
    "case_key",
    "section_type",
    "district",
    "department_domain",
    "source_department",
    "source_topic",
    "source_sheet",
    "category_leaf",
    "applicable_area"
  ],
  "boost_fields": [
    {"metadata": "question", "weight": 2.0, "match": "fuzzy_overlap"},
    {"metadata": "aliases", "weight": 1.8, "match": "fuzzy_overlap"},
    {"metadata": "service_aliases", "weight": 1.8, "match": "fuzzy_overlap"},
    {"metadata": "service_name", "weight": 1.7, "match": "contains"},
    {"metadata": "case_title", "weight": 1.6, "match": "contains"},
    {"metadata": "keywords", "weight": 1.4, "match": "overlap"},
    {"metadata": "source_topic", "weight": 1.3, "match": "contains"},
    {"metadata": "chunk_kind", "weight": 1.1, "match": "exact"}
  ],
  "anchor_fields": [
    {
      "metadata": "district",
      "weight": 2.0,
      "aliases": {
        "新北区": ["新北区", "新北"],
        "经开区": ["经开区", "经开", "常州经开区"],
        "天宁区": ["天宁区", "天宁"],
        "武进区": ["武进区", "武进"],
        "溧阳市": ["溧阳市", "溧阳"],
        "金坛区": ["金坛区", "金坛"],
        "钟楼区": ["钟楼区", "钟楼"]
      }
    }
  ],
  "rerank_features": [
    "gov_knowledge_type",
    "knowledge_section",
    "chunk_kind",
    "section_type",
    "district",
    "source_department",
    "source_topic",
    "service_name",
    "service_aliases",
    "case_title",
    "case_key",
    "question",
    "aliases",
    "keywords",
    "retrieval_intents",
    "category_leaf",
    "applicable_area"
  ],
  "fallback": {
    "enabled": true,
    "expand_top_k_multiplier": 2
  },
  "response_compaction": {
    "enabled": true,
    "min_top_score": 0.8,
    "relative_score_floor": 0.65,
    "min_records": 1
  }
}
