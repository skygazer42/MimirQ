  "response_hints": {
    "answer_prefix": "答案要点",
    "source_prefix": "原始证据",
    "structured_labels": [
      "答案",
      "事项名称",
      "问题",
      "相似问法",
      "办理地点",
      "收费情况",
      "咨询方式",
      "办理时间",
      "受理条件",
      "在线办理地址"
    ],
    "answer_labels": ["答案"],
    "answer_keywords": ["答案"],
    "answer_highlight_metadata": ["answer_highlights", "answer_key_points", "summary_points"],
    "answer_highlight_metadata_fields": [
      {"metadata": "answer", "label": "答案", "max_chars": 1600},
      {
        "metadata": "service_fields",
        "fields": ["办理地点", "咨询方式", "办理时间", "办理材料", "在线办理地址"],
        "when_metadata": {"gov_knowledge_type": "service_item"},
        "max_chars": 1200
      },
      {"metadata": "case_title", "label": "一件事", "max_chars": 200},
      {
        "metadata": "related_services",
        "label": "涉及事项",
        "when_metadata": {"section_type": "related_services"},
        "max_chars": 1200
      },
      {
        "metadata": "materials",
        "label": "申请材料",
        "when_metadata": {"section_type": "materials"},
        "max_chars": 1200
      },
      {
        "metadata": "operation_steps",
        "label": "操作步骤",
        "when_metadata": {"section_type": ["operation_steps", "operation_material_upload", "operation_query"]},
        "max_chars": 1200
      },
      {
        "metadata": "urls",
        "label": "办理入口",
        "when_metadata": {"section_type": ["channels", "materials", "operation_entry", "operation_url"]},
        "max_chars": 1200
      }
    ],
    "existing_hint_prefixes": ["答案要点"],
    "anchor_only_chunk_kinds": ["qa_pair", "qa"],
    "anchor_only_markers": ["问题", "检索锚点", "相似问"],
    "groups": [
      {
        "name": "qa",
        "required_any_labels": ["答案"],
        "hint_labels": ["问题", "答案"]
      },
      {
        "name": "service_item",
        "required_any_labels": ["事项名称", "办理地点"],
        "hint_labels": ["事项名称", "办理地点", "收费情况", "咨询方式", "办理时间", "受理条件"],
        "question_from_query_label": "问题",
        "answer_label": "答案",
        "query_gate": {
          "content_labels": ["事项名称", "相似问法"],
          "metadata": ["service_name", "service_aliases", "aliases", "primary_alias"],
          "min_chars": 4,
          "min_common_chars": 3
        }
      }
    ],
    "enumeration": {
      "enabled": true,
      "intro_terms": ["类型", "类别", "方式", "入口"],
      "query_terms": ["申请", "入口", "类型", "类别", "哪些", "什么", "如何"],
      "max_terms": 4,
      "named_markers": {"1": "方式一", "2": "方式二", "3": "方式三", "4": "方式四"},
      "prefix": "必答要点",
      "message_template": "回答申请/入口/类型类问题时必须保留这些选项名称：{terms}",
      "term_separator": "、"
    }
  },
  "filter_fields": [
    "gov_knowledge_plugin",
    "gov_knowledge_type",
    "knowledge_section",
    "source_record_id",
    "chunk_kind",
    "service_name",
    "case_title",
    "case_key",
    "section_type",
    "district",
    "department_domain",
    "source_department",
    "source_topic",
    "source_sheet",
    "category_leaf",
    "applicable_area"
  ],
  "boost_fields": [
    {"metadata": "question", "weight": 2.0, "match": "fuzzy_overlap"},
    {"metadata": "aliases", "weight": 1.8, "match": "fuzzy_overlap"},
    {"metadata": "service_aliases", "weight": 1.8, "match": "fuzzy_overlap"},
    {"metadata": "service_name", "weight": 1.7, "match": "contains"},
    {"metadata": "case_title", "weight": 1.6, "match": "contains"},
    {"metadata": "keywords", "weight": 1.4, "match": "overlap"},
    {"metadata": "source_topic", "weight": 1.3, "match": "contains"},
    {"metadata": "chunk_kind", "weight": 1.1, "match": "exact"}
  ],
  "anchor_fields": [
    {
      "metadata": "district",
      "weight": 2.0,
      "aliases": {
        "新北区": ["新北区", "新北"],
        "经开区": ["经开区", "经开", "常州经开区"],
        "天宁区": ["天宁区", "天宁"],
        "武进区": ["武进区", "武进"],
        "溧阳市": ["溧阳市", "溧阳"],
        "金坛区": ["金坛区", "金坛"],
        "钟楼区": ["钟楼区", "钟楼"]
      }
    }
  ],
  "rerank_features": [
    "gov_knowledge_type",
    "knowledge_section",
    "chunk_kind",
    "section_type",
    "district",
    "source_department",
    "source_topic",
    "service_name",
    "service_aliases",
    "case_title",
    "case_key",
    "question",
    "aliases",
    "keywords",
    "retrieval_intents",
    "category_leaf",
    "applicable_area"
  ],
  "fallback": {
    "enabled": true,
    "expand_top_k_multiplier": 1
  },
  "response_compaction": {
    "enabled": true,
    "min_top_score": 0.8,
    "relative_score_floor": 0.65,
    "min_records": 1
  }
}
